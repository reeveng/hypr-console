[Unit]
Description=Night colors
PartOf=console.target

[Service]
Type=notify
ExecCondition=/usr/local/bin/console-warm switched-on
ExecStart=/usr/local/bin/console-warm daemon
ExecStopPost=-/usr/local/bin/console-report-crash %n
Restart=on-failure
RestartSec=5

# What this reaches past `console-.service.d/confining.conf`, and why.
#
# Night Light reads the saved setting and location and sends color transforms
# to the compositor over Wayland.
PrivateDevices=yes
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=console.target
