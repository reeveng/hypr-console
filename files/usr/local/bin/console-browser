#!/bin/sh
# The browser this desktop means, opened on whatever it opens on.
#
# xdg-settings is asked rather than a name being written down here, so the
# button follows the browser chosen on the settings panel's Defaults tab.
desktop=$(xdg-settings get default-web-browser 2>/dev/null)
for dir in "$HOME/.local/share/applications" /usr/local/share/applications /usr/share/applications; do
    if [ -n "$desktop" ] && [ -f "$dir/$desktop" ]; then
        exec gio launch "$dir/$desktop"
    fi
done
# Nothing answered for the default. The browser is still what opens a link.
exec xdg-open https://duckduckgo.com
