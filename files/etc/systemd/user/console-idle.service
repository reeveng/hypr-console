[Unit]
Description=Console inactivity and sleep management
PartOf=console.target

[Service]
Type=notify
NotifyAccess=main
ExecStartPre=-/usr/local/bin/console-compositor display-on
ExecStart=/usr/local/bin/lock-screen idle
# Undim powers the display on and restores its last brightness.
ExecStopPost=-/usr/local/bin/console-brightness undim
ExecStopPost=-/usr/local/bin/console-report-crash %n
Restart=always
RestartSec=5
PrivateDevices=yes
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=console.target
