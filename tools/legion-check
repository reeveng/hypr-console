#!/usr/bin/env python3
"""Everything this desktop has grown, tried again, oldest first.

    tools/legion-check                    here, against the emulator
    tools/legion-check --list             what there is, and what each is
    tools/legion-check brightness         only the checks about that
    tools/legion-check --stage device --dry     what it would do to the device
    tools/legion-check --stage device --yes     do it

The device is the last stage and it is somebody's machine. Nothing is sent to
it without --yes, and --dry prints every command first so it can be read before
it is run. The pressing goes through InputPlumber's own SendEvent, which is how
the hardware's own buttons arrive, so nothing is created on the device and
nothing is left behind if this stops halfway.
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from harness import checking                      # noqa: E402
from harness.stage import Desktop, Device, Here   # noqa: E402

GREEN, RED, DIM, YELLOW, OFF = ("\033[32m", "\033[31m", "\033[2m",
                                "\033[33m", "\033[0m")
if not sys.stdout.isatty():
    GREEN = RED = DIM = YELLOW = OFF = ""

MARK = {"ok": GREEN + "ok" + OFF, "failed": RED + "failed" + OFF,
        "skipped": DIM + "skipped" + OFF, "would": YELLOW + "would run" + OFF}


def main():
    parser = argparse.ArgumentParser(prog="legion-check", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("only", nargs="*", help="run only checks named this")
    parser.add_argument("--stage", default="here",
                        choices=("here", "desktop", "device"))
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--dry", action="store_true",
                        help="print what would be done, do nothing")
    parser.add_argument("--yes", action="store_true",
                        help="required before anything is sent to the device")
    args = parser.parse_args()

    checks = checking.load(args.only)
    if not checks:
        print("no checks by that name", file=sys.stderr)
        return 1

    if args.list:
        for check in checks:
            print("%-28s %s" % (check.name, check.about))
        return 0

    if args.stage == "device" and not (args.yes or args.dry):
        print("that is somebody's machine. Add --dry to see what would happen, "
              "or --yes to do it.", file=sys.stderr)
        return 2

    made = None
    counted = {"ok": 0, "failed": 0, "skipped": 0, "would": 0}
    shared = args.stage in ("device", "desktop")
    for check in checks:
        stage = made if shared else Here()
        if stage is None:
            stage = made = (Device(dry=args.dry) if args.stage == "device"
                            else Desktop())
        how, why = checking.run(check, stage)
        counted[how] += 1
        print("%-28s %-18s %s" % (check.name, MARK[how], DIM + why + OFF if why else ""))
        if not shared:
            stage.close()

    if args.dry and made is not None:
        print("\n%sit would have run:%s" % (YELLOW, OFF))
        for command in made.done:
            print("  %s" % command)

    if shared and made is not None and not args.dry:
        made.close()

    print("\n%d ok, %d failed, %d skipped%s"
          % (counted["ok"], counted["failed"], counted["skipped"],
             ", %d would run" % counted["would"] if counted["would"] else ""))
    return 1 if counted["failed"] else 0


if __name__ == "__main__":
    sys.exit(main())
