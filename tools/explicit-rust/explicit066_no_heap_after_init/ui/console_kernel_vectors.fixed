// run-rustfix
// rustfix-only-machine-applicable
// edition:2024

fn read(_: &[u8]) {}
fn generic<T>(_: &[T]) {}
fn write(_: &mut [u8]) {}
fn owned(_: Vec<u8>) {}

const COUNT: usize = 3;

fn main() {
    read(&[]);
    generic(&::core::convert::identity::<[u16; 0]>([]));
    read(&[]);
    read(&[1, 2]);
    write(&mut [4; 3]);
    read(&[0; COUNT]);

    let list = [5, 6,];
    read(&list);
    read(list.as_slice());
    let mut empty = [];
    write(&mut empty);

    for value in [1_u8, 2] {
        std::hint::black_box(value);
    }
    for value in ::core::convert::identity::<[u8; 0]>([]) {
        std::hint::black_box(value);
    }

    let mut grow = Vec::new();
    grow.push(1);
    read(&grow);
    owned(vec![2, 3]);
    let n = std::hint::black_box(4);
    read(&vec![1; n]);
    read(&vec![1; 4096]);

    macro_rules! both {
        ($value:expr) => {
            read(&$value);
            owned($value);
        }
    }
    both!(vec![1]);
    both!(Vec::new());
}
