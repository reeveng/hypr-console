#%PAM-1.0
# The greeter's own session, which exists so logind hands it the screen and the
# pad. It is never authenticated -- the login window only opens it -- so asking
# it to authenticate anybody is refused, and it is an account only the greeter
# has.
auth       required     pam_deny.so
account    required     pam_succeed_if.so user = console-greeter
password   required     pam_deny.so
session    optional     pam_keyinit.so force revoke
session    optional     pam_systemd.so
