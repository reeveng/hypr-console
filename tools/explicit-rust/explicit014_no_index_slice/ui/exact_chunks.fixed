// run-rustfix
// edition:2024
// rustc-env:CARGO_PKG_RUST_VERSION=1.94

// Read packed RGB triples and leave an incomplete final pixel out.
fn pixels(input: &[u8]) -> Vec<[u8; 4]> {
    let mut output = Vec::new();
    for [px_0, px_1, px_2] in <[_]>::as_chunks::<3>(input).0 {
        output.push([*px_0, *px_1, *px_2, 255]);
    }
    output
}

fn apply_transfer(data: &mut Vec<u8>) {
    for [data_0, data_1, data_2] in <[_]>::as_chunks_mut::<3>(data).0 {
        *data_0 = (*data_0).wrapping_add(1);
        *data_1 = (*data_1).wrapping_add(2);
        *data_2 = (*data_2).wrapping_add(3);
    }
}

fn mask(pixel: &[u8], bounds: &[u8]) -> bool {
    for (component, [min_max_0, min_max_1]) in ::core::iter::Iterator::zip(pixel.iter(), <[_]>::as_chunks::<2>(bounds).0) {
        if *component > *min_max_1 || *component < *min_max_0 {
            return true;
        }
    }
    false
}

fn copy_channels(input: &[u8], output: &mut [u8]) {
    for ([src_0, src_1], [dst_0, dst_1]) in ::core::iter::Iterator::zip(<[_]>::as_chunks::<2>(input).0.iter(), <[_]>::as_chunks_mut::<2>(output).0) {
        *dst_0 = *src_1;
        *dst_1 = *src_0;
    }
}

fn deltas(input: &[i16]) -> Vec<i16> {
    let mut output = Vec::new();
    for [pair_0, pair_1] in <[_]>::array_windows::<2>(input) {
        output.push(*pair_1 - *pair_0);
    }
    output
}

fn glyph_ids(bytes: &[u8]) -> Vec<(usize, u16)> {
    let mut output = Vec::new();
    for (cid, [gid_0, gid_1]) in ::core::iter::Iterator::enumerate(<[_]>::as_chunks::<2>(bytes).0.iter()) {
        output.push((cid, u16::from_be_bytes([*gid_0, *gid_1])));
    }
    output
}

fn main() {
    let mut data = vec![1, 2, 3, 4, 5, 6, 99];
    assert_eq!(pixels(&data), vec![[1, 2, 3, 255], [4, 5, 6, 255]]);
    apply_transfer(&mut data);
    assert_eq!(data, vec![2, 4, 6, 5, 7, 9, 99]);
    assert!(mask(&[24, 12], &[23, 25, 13, 15, 34]));
    assert!(!mask(&[24], &[23, 25, 13, 15, 34]));
    let mut out = [0; 5];
    copy_channels(&[1, 2, 3, 4, 5], &mut out);
    assert_eq!(out, [2, 1, 4, 3, 0]);
    assert_eq!(deltas(&[4, 9, 3]), [5, -6]);
    assert!(deltas(&[]).is_empty());
    assert_eq!(glyph_ids(&[1, 2, 3, 4, 255]), [(0, 0x0102), (1, 0x0304)]);
}
