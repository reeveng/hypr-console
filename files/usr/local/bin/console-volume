#!/bin/sh
# The rocker on the top edge.
#   console-volume up | down | mute
#
# Turning it up also unsilences it. The rocker was bound straight to the
# volume, so on a muted machine pressing it moved a number nobody could hear
# and the buttons looked broken. Turning it down does not unsilence: someone
# who has just silenced the thing and reaches for down means quieter still,
# not louder.
STEP=5%
SINK=@DEFAULT_SINK@

# Where the number went when it left the bar.
#
# The bar wears a glyph and no percentage now: the three speaker marks say
# quiet, middling and loud, which is what the icon is for, and a row of six
# readings where three carry numbers and three do not is a row that reads as
# two rows. What the number was actually for is this rocker -- pressing it and
# seeing the figure move is how anybody knows it did anything -- so the figure
# is said here, at the moment it changes, where somebody is already looking.
#
# One notice, replaced. Held down, the rocker steps five per cent at a time and
# every step would otherwise be another card, so the number the last one came
# back under is kept and handed to --replace-id. Same technique as
# console-updating; two of them is not yet a pattern worth a file of its own.
kept=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/console/volume

said() {
    now=$(pactl get-sink-volume "$SINK" 2>/dev/null | awk 'NR==1 {print $5; exit}')
    case $(pactl get-sink-mute "$SINK" 2>/dev/null) in
    *yes) summary="Silent" ;;
    *) summary="Volume ${now:-?}" ;;
    esac
    was=$(cat "$kept" 2>/dev/null)
    # The value hint is sent and mako ignores it -- it draws a summary and a
    # body and has no bar to put a number in. Sent anyway because it costs a
    # word and is what any daemon that can draw one reads, and because the
    # sentence is the reading either way: five per cent a press is a figure
    # somebody is counting, not a length they are eyeing.
    id=$(notify-send --app-name=Console --print-id --expire-time=1500 \
        -h "int:value:${now%\%}" ${was:+--replace-id="$was"} -- "$summary" 2>/dev/null)
    [ -n "$id" ] || return 0
    mkdir -p "${kept%/*}" 2>/dev/null || return 0
    printf '%s\n' "$id" > "$kept" 2>/dev/null || true
}

case "$1" in
up)
    pactl set-sink-mute "$SINK" 0
    pactl set-sink-volume "$SINK" "+$STEP"
    ;;
down)
    pactl set-sink-volume "$SINK" "-$STEP"
    ;;
mute)
    pactl set-sink-mute "$SINK" toggle
    ;;
*)
    echo "usage: console-volume [up|down|mute]" >&2
    exit 2
    ;;
esac

# Never the reason the rocker fails. The volume has already moved by here, and
# a notification that would not draw is not worth handing that back over.
said || true
