// run-rustfix
// edition:2024
// aux-build:console_core_number_conversion.rs
#![deny(unused_parens)]

extern crate console_core_number_conversion;

type WireWord = i16;

const fn widen_signed(value: i8) -> u16 {
    ::console_core_number_conversion::const_wrapped_integer!(signed ::core::primitive::i8 => ::core::primitive::u16, value)
}

const fn narrow_unsigned(value: u64) -> WireWord {
    ::console_core_number_conversion::const_wrapped_integer!(unsigned ::core::primitive::u64 => WireWord, value)
}

const fn to_index(value: u8) -> usize {
    ::console_core_number_conversion::const_wrapped_integer!(unsigned ::core::primitive::u8 => ::core::primitive::usize, value)
}

const fn same_width(value: i32) -> i32 {
    ::core::convert::identity::<::core::primitive::i32>(value)
}

macro_rules! source {
    () => { 255_u8 };
}

const SIGN_EXTENDED: u16 = widen_signed(-128);
const NARROWED: i16 = narrow_unsigned(0x1ffff);
const INDEX: usize = to_index(137);
const UNCHANGED: i32 = same_width(-9);
const MACRO_OPERAND: usize = ::console_core_number_conversion::const_wrapped_integer!(unsigned ::core::primitive::u8 => ::core::primitive::usize, source!());
const FLAG: usize = ::core::convert::identity::<::core::primitive::usize>(match matches!(MACRO_OPERAND, 255) { true => 1, false => 0 });

const fn pair_sum((left, right): (u16, u16)) -> u16 {
    left + right
}

const BINARY: u8 = ::console_core_number_conversion::const_wrapped_integer!(unsigned ::core::primitive::u16 => ::core::primitive::u8, pair_sum((1, 2)) + ::console_core_number_conversion::const_wrapped_integer!(unsigned ::core::primitive::u32 => ::core::primitive::u16, 1_u32));
const LEFT_CAST: u8 = ::console_core_number_conversion::const_wrapped_integer!(unsigned ::core::primitive::u16 => ::core::primitive::u8, ::console_core_number_conversion::const_wrapped_integer!(unsigned ::core::primitive::u32 => ::core::primitive::u16, 1_u32) + 3);

const _: () = {
    assert!(SIGN_EXTENDED == 65408);
    assert!(NARROWED == -1);
    assert!(INDEX == 137);
    assert!(UNCHANGED == -9);
    assert!(MACRO_OPERAND == 255);
    assert!(FLAG == 1);
    assert!(BINARY == 4);
    assert!(LEFT_CAST == 4);
};

fn runtime(value: i32) -> (u8, WireWord) {
    (match ::console_core_number_conversion::wrapped::<_, ::core::primitive::u8>(value) { ::core::result::Result::Ok(converted_position) => converted_position }, match ::console_core_number_conversion::wrapped::<_, WireWord>(value) { ::core::result::Result::Ok(converted_position) => converted_position })
}

fn main() {
    assert_eq!(runtime(-257), (255, -257));
}
