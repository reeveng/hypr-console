#!/bin/sh
# Leave Steam and come back to the desktop. Held on the left Legion button,
# which is the button the desktop left on.
#
# Nothing to do if the desktop already has the screen, which is the same rule
# `game-mode` keeps in the other direction. It is also what makes a button held
# a moment too long harmless: the session takes a while to go, the hold is only
# acted on once, and a second call arriving from anywhere else finds Game Mode
# already gone and stops here.
systemctl --user is-active --quiet gamescope-session.target || exit 0

# The controller is not put back to the desktop map here. That is the first
# thing the desktop's own controller daemon does when its target starts, and
# doing it twice would take the pad away from Steam on the way out for no
# reason.
exec /usr/local/bin/steamos-session-select plasma
