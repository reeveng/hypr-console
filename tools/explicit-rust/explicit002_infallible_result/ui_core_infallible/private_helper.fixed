// run-rustfix
// edition:2024

#![no_std]
extern crate std;

fn trimmed_length(text: &str) -> ::core::result::Result<usize, ::core::convert::Infallible> { ::core::result::Result::Ok(text.trim().len()) }

fn main() {
    let ::core::result::Result::Ok(length) = trimmed_length(" label ");
    std::assert_eq!(length, 5);
}
