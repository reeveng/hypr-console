#!/usr/bin/env python3
"""What every button does.

    legion-buttons             print the guide
    legion-buttons --menu      show it on screen, closed with B
    legion-buttons --identify  press a button and be told which one it is

The guide is read out of the files that decide it, so it cannot drift from
what the device actually does. The controller map names each mapping in plain
words and those names are what you see here: change desktop.yaml and the guide
changes with it.
"""

import re
import subprocess
import sys
from pathlib import Path

PROFILE = Path("/etc/inputplumber/profiles/desktop.yaml")
HYPR = Path("/home/player/.config/hypr/hyprland.lua")

# Named by number, not by shade: 35 and 37 are whatever the terminal's palette
# says magenta and white are, which on this machine is the pink and the quiet
# colour every other surface uses. The dim attribute is not used anywhere here.
# It halves whatever it is applied to, and half of a colour chosen to clear
# 7:1 is a colour that does not.
BOLD, QUIET, PINK, OFF = "\033[1m", "\033[37m", "\033[35m", "\033[0m"
if not sys.stdout.isatty():
    BOLD = QUIET = PINK = OFF = ""


def heading(text):
    print(f"\n{PINK}{BOLD}{text}{OFF}")
    print(f"{QUIET}{'─' * 46}{OFF}")


def row(button, does):
    print(f"  {BOLD}{button:<22}{OFF}{does}")


def controller_map():
    """Each mapping in the profile is named "Button - what it does"."""
    pairs = []
    for line in PROFILE.read_text().splitlines():
        match = re.match(r"\s*- name:\s*(.+)", line)
        if not match:
            continue
        name = match.group(1).strip()
        button, _, does = name.partition(" - ")
        pairs.append((button, does or ""))
    return pairs


def keyboard_shortcuts():
    """The binds for when a real keyboard is plugged in."""
    text = HYPR.read_text() if HYPR.exists() else ""
    out = []
    for match in re.finditer(r'hl\.bind\((.+?),\s*hl\.dsp\.(.+?)\)\n', text):
        keys, action = match.group(1), match.group(2)
        keys = keys.replace('mod .. "', 'Super').replace('"', '').strip()
        keys = re.sub(r"\s+", " ", keys).replace("Super + ", "Super + ")
        command = re.search(r'exec_cmd\("(.+?)"\)', action)
        if command:
            action = "run " + command.group(1).split("/")[-1]
        else:
            action = action.split("(")[0].replace("window.", "").replace("_", " ")
        out.append((keys, action))
    return out


def sections():
    """Every part of the guide, in the order it is learned.

    One list, read twice: printed as headings in a terminal, and drawn as tabs
    on the device. A section that exists in one and not the other is how a
    guide starts lying.
    """
    return [
        ("Getting around",
         [(button, does or "nothing yet") for button, does in controller_map()] + [
             ("Volume rocker", "louder, quieter; louder also unsilences"),
             ("Touchpad", "move the pointer"),
             ("Tap the touchpad", "click"),
             ("Press the touchpad in", "click and hold, to drag"),
         ]),
        ("Held with L2", [
            ("L1 / R1", "carry this window to the workspace before or after"),
            ("D-pad left", "screen dimmer"),
            ("D-pad right", "screen brighter"),
        ]),
        ("Keyboard up", [
            ("X", "put the keyboard away"),
            ("A", "press the key you are on"),
            ("B", "backspace"),
            ("Y", "shift"),
            ("D-pad", "move between keys"),
            ("L1 / R1", "previous / next set of keys"),
            ("Menu", "enter"),
            ("Stick press", "press the key you are on"),
        ]),
        ("In a menu", [
            ("D-pad", "move the highlight"),
            ("A", "choose what is highlighted"),
            ("B", "back out"),
            ("X", "show or hide the keyboard"),
            ("L1 / R1", "the tab to the left or right, where there are tabs"),
            ("D-pad left / right", "move a level, on a row that carries one"),
            ("Right paddle, top", "close the menu"),
        ]),
        ("Typed", keyboard_shortcuts()),
    ]


def print_guide():
    print(f"\n{BOLD}The buttons on this device{OFF}")

    for title, lines in sections():
        if not lines:
            continue
        heading(title)
        for button, does in lines:
            row(button, does)

    print(f"\n{QUIET}  Not sure which paddle is which? Run:  legion-buttons --identify{OFF}\n")


def identify():
    """Name whatever button is pressed next.

    The controller daemon is paused first. It reads the same pad, and the
    close-window paddle is the one people most want to identify, which would
    otherwise shut the window they are reading this in.
    """
    try:
        from evdev import InputDevice, categorize, ecodes, list_devices
    except ImportError:
        sys.exit("python-evdev is not installed.")

    pad = None
    for path in list_devices():
        device = InputDevice(path)
        capabilities = device.capabilities().get(ecodes.EV_KEY, [])
        if ecodes.BTN_SOUTH in capabilities:
            pad = device
            break
    if pad is None:
        sys.exit("No controller found.")

    unit = "legion-controller.service"
    subprocess.run(["systemctl", "--user", "kill", "--signal=STOP", unit], check=False)
    print("Press a button. Ctrl-C to stop.\n")
    try:
        for event in pad.read_loop():
            if event.type == ecodes.EV_KEY and event.value == 1:
                names = ecodes.bytype[ecodes.EV_KEY][event.code]
                name = names[0] if isinstance(names, list) else names
                print(f"  {BOLD}{name}{OFF}  (code {event.code})")
    except KeyboardInterrupt:
        pass
    finally:
        subprocess.run(["systemctl", "--user", "kill", "--signal=CONT", unit], check=False)
        print("\nController resumed.")


def show_on_screen():
    """The guide as the panel everything else here is drawn as.

    A terminal would want a keyboard to scroll it and a keyboard to leave it.
    The panel scrolls on the d-pad, moves between sections on the shoulders,
    and closes on B, which is what the guide is describing in the first place.
    """
    sys.path.insert(0, "/usr/local/lib/legion")
    import panel

    pages = [(title, [(button, does, None) for button, does in lines])
             for title, lines in sections() if lines]
    panel.show(pages, width=900, column=250, height=500)


if __name__ == "__main__":
    if "--identify" in sys.argv:
        identify()
    elif "--menu" in sys.argv:
        show_on_screen()
    else:
        print_guide()
