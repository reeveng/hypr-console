// run-rustfix
// edition:2024
// compile-flags: --test

#[derive(Debug, PartialEq)]
enum ReadError { Truncated }

fn read(bytes: &[u8]) -> Result<u8, ReadError> {
    bytes.first().copied().ok_or(ReadError::Truncated)
}

fn glyph(id: u8) -> Option<&'static str> {
    match id { 0 => Some(".notdef"), _ => None }
}

#[test]
fn checks_a_font_reader() {
    assert_eq!(read(&[0xAA]), ::core::result::Result::Ok(0xAA));
    assert_eq!(::core::result::Result::Ok(0), read(&[0]));
    assert_eq!(glyph(0), ::core::option::Option::Some(".notdef"));
    let expected = -3i32;
    assert_eq!(Some(-3i32), ::core::option::Option::Some(expected));
}

#[test]
fn consumes_a_reader_once() {
    let mut bytes = [12u8, 35].into_iter();
    assert_eq!(bytes.next(), ::core::option::Option::Some(12));
    assert_eq!(::core::option::Option::Some(35), bytes.next());
    assert!(bytes.next().is_none());
}

#[derive(Debug)]
struct ParseError;
fn read_int(value: i32) -> Result<i32, ParseError> { Ok(value) }

#[test]
fn postscript_operands() -> ::core::result::Result<(), crate::ParseError> {
    let asserted_value = read_int(20)?;
    assert_eq!(asserted_value, 20);
    let asserted_value_2 = read_int(-102)?;
    assert_eq!(asserted_value_2.abs(), 102);
    let asserted_value_3 = read_int(4)?;
    assert_eq!(4, asserted_value_3);
    ::core::result::Result::Ok(())
}

#[derive(Debug)]
enum Impossible {}
fn fixed_value() -> Result<u8, Impossible> { Ok(2) }

#[test]
fn infallible_reads_have_individual_edits() -> Result<(), Impossible> {
    let first = match fixed_value() { ::core::result::Result::Ok(_explicit_value) => _explicit_value, ::core::result::Result::Err(_explicit_error) => match _explicit_error {} };
    assert_eq!((match fixed_value() { ::core::result::Result::Ok(_explicit_value) => _explicit_value, ::core::result::Result::Err(_explicit_error) => match _explicit_error {} }), first);
    Ok(())
}
