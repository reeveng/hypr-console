[Unit]
Description=Console wallpaper renderer
PartOf=console.target
Wants=console-wallpaper.service

[Service]
Type=notify
# The renderer accepts a picture before any output finishes configuring.
# The startup color covers outputs as soon as they are ready.
# console-palette:begin
# Written by console-palette from theme/palette.toml.
ExecStart=/usr/local/bin/console-paper serve 110b12
# console-palette:end
ExecStopPost=-/usr/local/bin/console-report-crash %n
Restart=always
RestartSec=2

PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=console.target
