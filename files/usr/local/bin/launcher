#!/usr/bin/env python3
"""The menu.

Applications come out in the order you actually use them: the ones you open
most, most often, and everything else alphabetically after them. wofi can sort
one way or the other but not both, so the list is built here and handed to it
in dmenu mode.

Run with any arguments, this is a plain dmenu and reads its entries from
standard input, which is what the power menu uses.
"""

import os
import re
import shlex
import signal
import struct
import subprocess
import sys
from pathlib import Path

COUNTS = Path.home() / ".local/state/legion/menu-counts"
FIELD_CODES = re.compile(r"%[fFuUdDnNickvm]")

def desktop_files():
    """Every application, later directories losing to earlier ones by id."""
    roots = [Path.home() / ".local/share/applications"]
    roots += [Path(d) / "applications"
              for d in os.environ.get("XDG_DATA_DIRS",
                                      "/usr/local/share:/usr/share").split(":")]
    found = {}
    for root in roots:
        if not root.is_dir():
            continue
        for path in sorted(root.rglob("*.desktop")):
            found.setdefault(path.name, path)
    return found.values()


# Where an icon named in a .desktop file is actually kept. Guessing the path
# does not work: icons sit under apps, devices or preferences depending on what
# they are, in whatever sizes the theme happened to ship, and a dark theme
# inherits most of its icons from the light one it is built from.
#
# So the whole tree is indexed once and the answer cached. Walking it takes
# about a second, which is a second too long to spend every time the menu
# opens, and installing something is the only thing that changes the answer.
ICON_ROOTS = ["/usr/share/icons", "/usr/share/pixmaps",
              str(Path.home() / ".local/share/icons"),
              str(Path.home() / ".icons")]
STEAM_ROOTS = [Path.home() / ".local/share/Steam",
               Path.home() / ".steam/steam"]
ICON_THEMES = ["Papirus-Dark", "Papirus", "hicolor", "breeze-dark", "breeze"]
INDEX = Path.home() / ".cache/legion/icon-index"

# Drawn for the applications that ship no icon, so their names still line up
# with everything else.
PLACEHOLDER = "/usr/share/icons/legion-placeholder.svg"

_index = None


def icons_changed_at():
    """The newest of the icon directories, which a package install touches."""
    newest = 0.0
    for root in ICON_ROOTS:
        path = Path(root)
        if not path.is_dir():
            continue
        newest = max(newest, path.stat().st_mtime)
        for child in path.iterdir():
            try:
                newest = max(newest, child.stat().st_mtime)
            except OSError:
                pass
    return newest


def rank(theme, size, suffix):
    """Lower is better: the right theme, drawn rather than pixelated, near 64."""
    try:
        theme_rank = ICON_THEMES.index(theme)
    except ValueError:
        theme_rank = len(ICON_THEMES)
    if size == "scalable":
        pixels = 64
    else:
        digits = re.match(r"(\d+)", size)
        if not digits:
            return None
        pixels = int(digits.group(1))
    if pixels < 24:
        return None
    return theme_rank, 0 if suffix == ".svg" else 1, abs(pixels - 64)


def build_index():
    """name -> the best file for it, over every theme on the machine."""
    best = {}
    for root in ICON_ROOTS:
        for directory, _, files in os.walk(root):
            parts = Path(directory).relative_to(root).parts
            theme = parts[0] if parts else ""
            # One layout puts the size before the category and the other after,
            # so whichever part looks like a size is the size.
            size = next((p for p in parts[1:3] if p[0].isdigit() or p == "scalable"), "48")
            for name in files:
                stem, suffix = os.path.splitext(name)
                if suffix not in (".svg", ".png", ".xpm"):
                    continue
                score = rank(theme, size, suffix)
                if score is None:
                    continue
                if stem not in best or score < best[stem][0]:
                    best[stem] = (score, os.path.join(directory, name))
    return {name: path for name, (_, path) in best.items()}


def load_index():
    """The cached index, rebuilt when something has been installed since."""
    global _index
    if _index is not None:
        return _index

    changed = icons_changed_at()
    if INDEX.exists() and INDEX.stat().st_mtime >= changed:
        _index = dict(
            line.split("\t", 1)
            for line in INDEX.read_text().splitlines() if "\t" in line)
        return _index

    _index = build_index()
    INDEX.parent.mkdir(parents=True, exist_ok=True)
    INDEX.write_text("".join("%s\t%s\n" % pair for pair in sorted(_index.items())))
    return _index


def image_size(path):
    """Width and height from the header, or None if it is not one we read."""
    try:
        with open(path, "rb") as handle:
            head = handle.read(65536)
    except OSError:
        return None

    if head[:8] == b"\x89PNG\r\n\x1a\n":
        return struct.unpack(">II", head[16:24])

    if head[:2] == b"\xff\xd8":
        i = 2
        while i + 9 < len(head):
            if head[i] != 0xFF:
                i += 1
                continue
            marker = head[i + 1]
            if marker in (0xC0, 0xC1, 0xC2, 0xC3):
                height, width = struct.unpack(">HH", head[i + 5:i + 9])
                return width, height
            if marker == 0xD8 or 0xD0 <= marker <= 0xD9:
                i += 2
                continue
            i += 2 + struct.unpack(">H", head[i + 2:i + 4])[0]
    return None


def steam_icon(appid):
    """A game's icon out of Steam's own cache.

    Steam writes an icon named steam_icon_<appid> into the .desktop file but
    does not always put a file of that name anywhere. The art it does keep is
    named by content hash, so the icon is found by shape instead: it is the
    square one. The rest is cover art and banners, which are the wrong shape
    for a row in a list, and are used only if there is no icon at all.
    """
    fallbacks = {}
    for root in STEAM_ROOTS:
        cache = root / "appcache/librarycache" / appid
        if not cache.is_dir():
            continue
        for path in sorted(cache.rglob("*")):
            if not path.is_file() or path.suffix.lower() not in (".jpg", ".png"):
                continue
            size = image_size(path)
            if not size:
                continue
            if size[0] == size[1]:
                return str(path)
            fallbacks.setdefault(path.name, str(path))
    for preferred in ("library_600x900.jpg", "logo.png", "library_header.jpg"):
        if preferred in fallbacks:
            return fallbacks[preferred]
    return None


def icon_path(name):
    """A file for an icon name, or None. Names may already be a path."""
    if not name:
        return None
    if name.startswith("/"):
        return name if Path(name).exists() else None

    found = load_index().get(name)
    if found:
        return found

    game = re.match(r"steam_icon_(\d+)$", name)
    return steam_icon(game.group(1)) if game else None


def entry(path):
    """Name, command and whether it wants a terminal, or None to skip it."""
    fields, section = {}, None
    for line in path.read_text(errors="replace").splitlines():
        line = line.strip()
        if line.startswith("["):
            section = line
        elif section == "[Desktop Entry]" and "=" in line:
            key, _, value = line.partition("=")
            fields.setdefault(key, value)

    if fields.get("Type") != "Application":
        return None
    if fields.get("NoDisplay", "").lower() == "true":
        return None
    if fields.get("Hidden", "").lower() == "true":
        return None
    try_exec = fields.get("TryExec")
    if try_exec and not shutil_which(try_exec):
        return None
    name, command = fields.get("Name"), fields.get("Exec")
    if not name or not command:
        return None
    return (name,
            FIELD_CODES.sub("", command).strip(),
            fields.get("Terminal", "").lower() == "true",
            icon_path(fields.get("Icon")))


def shutil_which(binary):
    from shutil import which
    return which(binary) if not binary.startswith("/") else Path(binary).exists()


def read_counts():
    counts = {}
    if COUNTS.exists():
        for line in COUNTS.read_text().splitlines():
            number, _, name = line.partition(" ")
            if name and number.isdigit():
                counts[name] = int(number)
    return counts


def bump(name):
    counts = read_counts()
    counts[name] = counts.get(name, 0) + 1
    COUNTS.parent.mkdir(parents=True, exist_ok=True)
    COUNTS.write_text("".join(f"{n} {k}\n" for k, n in sorted(counts.items())))


def wofi(lines, extra, profile="menu"):
    """Show the list, and say how it ended.

    A chooser is driven by its highlight, so while one is up A confirms the
    highlighted row rather than clicking wherever the pointer sits. The desktop
    gets its own profile back whichever way this ends, including a crash.
    """
    subprocess.run(["controller-profile", profile],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        process = subprocess.run(
            ["wofi", "--dmenu", *extra],
            input="\n".join(lines), capture_output=True, text=True)
        return process.stdout.strip(), process.returncode
    finally:
        subprocess.run(["controller-profile", "desktop"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    # Asked to stop, put the controller back before going. Only a SIGKILL gets
    # past this, and the controller service repairs that at its next start.
    for stopped in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(stopped, lambda *_: sys.exit(1))

    extra = [a for a in sys.argv[1:] if a != "--dmenu"]

    if "--dmenu" in sys.argv:
        # A plain dmenu: the caller has already decided what the entries are.
        chosen, _ = wofi(sys.stdin.read().splitlines(), extra)
        print(chosen)
        return 0

    apps = {}
    for path in desktop_files():
        found = entry(path)
        if found:
            apps.setdefault(found[0], found[1:])

    counts = read_counts()
    order = sorted(apps, key=lambda name: (-counts.get(name, 0), name.lower()))

    # wofi draws an icon when a line is written as img:<file>:text:<label>.
    lines = ["img:%s:text:%s" % (apps[name][2] or PLACEHOLDER, name)
             for name in order]

    chosen, _ = wofi(lines, ["--allow-images", *extra])
    if ":text:" in chosen:
        chosen = chosen.split(":text:", 1)[1]
    if not chosen or chosen not in apps:
        return 0

    command, wants_terminal, _ = apps[chosen]
    bump(chosen)
    argv = shlex.split(command)
    if wants_terminal:
        argv = ["alacritty", "-e", *argv]
    subprocess.Popen(argv, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
