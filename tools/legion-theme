def breeze_role(name):
    """Which of our colours one of Breeze's names is asking for.

    Read in order, because the names overlap: a selected foreground is a
    foreground and a selected one, and the second word is the one that decides.
    Anything greyed out still answers `soft`, which clears AAA. Unreadable
    disabled text is a convention rather than a requirement, and on a device
    somebody is meant to be able to use it is a bad one.
    """
    for word, role in [
        ("selected_fg", "night"), ("selected_bg", "pink"),
        ("decoration_focus", "pink"), ("decoration_hover", "pink"),
        ("view_active_decoration", "pink"), ("view_hover_decoration", "edge"),
        ("error", "coral"), ("warning", "butter"), ("success", "leaf"),
        ("link_visited", "mauve"), ("link_color", "sky"),
        ("borders", "edge"), ("tooltip_border", "edge"),
        ("tooltip_background", "panel"), ("tooltip_text", "text"),
        ("base_fg", "text"), ("base_color", "night"),
        ("content_view_bg", "night"), ("view_bg", "night"),
        ("view_text", "text"), ("text_color", "text"),
        ("foreground_active", "pink"), ("foreground", "text"),
        ("fg_color", "text"),
        ("background_light", "panel"), ("button_background", "panel"),
        ("header_background", "ground"), ("titlebar_background", "ground"),
        ("bg_color", "panel"),
    ]:
        if word in name:
            if role in ("text",) and "insensitive" in name:
                return "soft"
            return role
    raise Short(f"no colour decided for Breeze's {name}")


# -------------------------------------------------------------------- the work

def written(spec, palette):
    """Every file the palette reaches, and what it should hold.

    Five of these are the palette itself, one per language that has to be
    spoken. The rest of the desktop imports whichever of them speaks its own,
    so this list is nearly the whole of where a colour appears on the machine.

    `region` means a file somebody else owns, where only what lies between the
    markers is written. `whole` means a file that is nothing but colour.
    """
    home = FILES / "home/player"
    chrome = home / ".mozilla/firefox/legion/chrome"
    return {
        # The palette, once per language.
        home / ".config/legion/palette.css": ("whole", gtk_palette(palette)),
        home / ".config/legion/palette.toml": ("whole", terminal_palette(palette, spec)),
        chrome / "palette.css": ("whole", firefox_palette(palette)),
        FILES / "usr/local/lib/legion/palette.sh": ("whole", shell_palette(palette)),

        # The two that cannot import anything. KDE's ini format has no include,
        # and a user.js is a list of literals.
        home / ".config/kdeglobals": ("region", kdeglobals_block(palette)),
        home / ".mozilla/firefox/legion/user.js": ("region", firefox_prefs_block(palette)),

        # The compositor. Two lines, written rather than imported: a Lua file
        # that fails to load takes the whole session with it, and the session
        # is the thing the person holding this device is standing on.
        home / ".config/hypr/hyprland.lua": ("region", hyprland_block(palette)),

        # Drawn.
        FILES / "usr/share/icons/legion-placeholder.svg": ("whole", placeholder(palette)),
    }


def report(spec, palette, rows):
    """The numbers, written down where somebody can read them without running this."""
    term = terminal_set(spec, palette)
    lines = [f"# {spec['meta']['name']}", "",
             spec["meta"]["about"], "",
             "Written by `tools/legion-theme` from `theme/palette.toml`. Every number",
             "here is measured after the colour has been quantised to eight bits a",
             "channel, which is what a contrast checker reads off the screen and is a",
             "tenth of a point away from the arithmetic on the same two colours.", "",
             "## The colours", "",
             "| | colour | spent on |", "| --- | --- | --- |"]
    for name, spec_of in spec["colour"].items():
        lines.append(f"| `{name}` | `#{palette[name]}` | {spec_of.get('spent', '')} |")

    lines += ["", "## What was asked of them", "",
              "| front | on | asked | got | |", "| --- | --- | --- | --- | --- |"]
    for front, back, asked, got, kind, _where in rows:
        lines.append(f"| `{front}` | `{back}` | {asked:g}:1 | **{got:.2f}:1** "
                     f"| {grade(got, kind)} |")

    lines += ["", "## The terminal", "",
              "| slot | normal | | bright | |", "| --- | --- | --- | --- | --- |"]
    for slot in ("black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"):
        normal, bright = term["normal"][slot], term["bright"][slot]
        lines.append(f"| {slot} | `#{normal}` | {col.contrast(normal, term['background']):.2f}:1 "
                     f"| `#{bright}` | {col.contrast(bright, term['background']):.2f}:1 |")
    return "\n".join(lines) + "\n"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true",
                        help="say what would change and change nothing")
    arguments = parser.parse_args()

    spec = tomllib.loads(PALETTE.read_text())
    palette = resolve(spec["colour"])
    rows = measure(spec, palette)

    short = [row for row in rows if row[3] < row[2]]
    if short:
        for front, back, asked, got, _kind, where in short:
            print(f"  {front} on {back}: asked {asked}:1, got {got:.2f}:1 ({where})")
        sys.exit("the palette does not clear what it declares; nothing written")

    work = written(spec, palette)
    work[REPORT] = ("whole", report(spec, palette, rows))

    changed = []
    for path, (kind, body) in sorted(work.items()):
        if kind == "region":
            wanted = region(path, body).encode()
        else:
            wanted = body.encode()
        if not path.exists() or path.read_bytes() != wanted:
            changed.append(path)
            if not arguments.check:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(wanted)

    canvas = FILES / "usr/share/backgrounds/legion.png"
    drawn = picture(spec)
    if not canvas.exists() or canvas.read_bytes() != drawn:
        changed.append(canvas)
        if not arguments.check:
            canvas.write_bytes(drawn)

    # The closest call is the one with the least room over what it was asked
    # for, which is not the same as the lowest ratio: the bar only has to be a
    # different colour from the wallpaper, and it always will be.
    worst = min(rows, key=lambda row: row[3] - row[2])
    text_rows = [row for row in rows if row[2] >= 7.0]
    print(f"{spec['meta']['name']}: {len(spec['colour'])} colours, "
          f"{len(rows)} pairings, all clearing what they declare.")
    print(f"  the closest call is {worst[0]} on {worst[1]}, asked for {worst[2]:g}:1 "
          f"and reaching {worst[3]:.2f}:1 ({grade(worst[3], worst[4])}).")
    print(f"  {len(text_rows)} of them are text, and every one is AAA.")

    if arguments.check and changed:
        for path in changed:
            print(f"  would rewrite {path.relative_to(ROOT)}")
        sys.exit(1)
    for path in changed:
        print(f"  wrote {path.relative_to(ROOT)}")
    if not changed:
        print("  every file already says this.")


if __name__ == "__main__":
    main()
