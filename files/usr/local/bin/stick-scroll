#!/usr/bin/env python3
"""The desktop half of the controller: scrolling, and the buttons that ask the
compositor for something.

Both live here for the same reason. Sending these through the compositor as key
bindings never held: function keys did not resolve to a keysym Hyprland would
match, raw keycodes were stored as literal strings, and a modifier plus a
letter races, because InputPlumber emits the pair in one event frame and the
letter can reach the focused window before the modifier applies. That is how
pressing X typed a k into the terminal. Reading the pad has no such ambiguity,
and has worked first time every time.

Turning the right stick into a scroll wheel.

InputPlumber can map a stick to a wheel notch, but an axis crossing its
deadzone is one press and one release, and a wheel notch does not repeat while
it is held. One flick gave one imperceptible notch. Arrow keys repeat, but in a
terminal an arrow key is command history, not scrolling.

So the stick stays an axis, and this turns how far it is pushed into how fast
the wheel turns.
"""

import os
import sys
import time

import subprocess

import evdev
from evdev import UInput, ecodes as e

DEADZONE = 0.20     # below this the stick is at rest
MAX_HZ = 22.0       # notches per second at full deflection
POLL = 0.02         # seconds between ticks

# The touchpad on the right face, turned into pointer movement.
#
# InputPlumber cannot do this. Asked to, it answers "Translation not
# implemented" once per event and drops them, so the pad did nothing at all no
# matter how it was mapped. Handing it to the compositor instead makes it an
# absolute device: touching the middle of the pad puts the cursor in the middle
# of the screen, which is not what a pad under a thumb is for. So it is read
# here, and what comes out is movement rather than position.
TOUCH_GAIN = 1.4        # screen pixels per unit of pad travel
TOUCH_POLL = 0.008      # seconds between reads while a finger is down

# Which way round the pad is. The pad reports in its own frame, and no part of
# the system says how that frame sits under a thumb, so it is written down here
# where a wrong guess is one word to fix.
TOUCH_SWAP = False      # the pad's X is the screen's Y
TOUCH_FLIP_X = False    # right on the pad is left on the screen
TOUCH_FLIP_Y = False    # down on the pad is up on the screen
TAP_SECONDS = 0.25      # a touch shorter than this can be a tap
TAP_TRAVEL = 40         # ... if it stayed within this many units


# Button to action. The daemon is paused while the on-screen keyboard is up, so
# these never compete with it for the same press.
# One button, one thing. Nothing here appears twice: a button that shares its
# job with another button is a button that could have been doing something
# nothing else does.
#
# The paddles arrive as an Elite controller's, which is what the profile now
# asks the pad to be. Which paddle is which is a fact about the hardware, not
# something the names settle, so it is written here in one place and confirmed
# by pressing them: `legion-buttons --identify` prints the code for whatever is
# pressed, and every press is logged here too.
# The back of the device, and Legion right. Each arrives as a key of its own on
# the keyboard InputPlumber publishes, so which button was pressed is a fact
# rather than a guess about button codes.
KEYS = {
    e.KEY_F13: ["launcher"],
    e.KEY_F15: ["hyprctl", "dispatch", "hl.dsp.window.close()"],
    e.KEY_F16: ["/usr/local/bin/legion-screenshot"],
    e.KEY_F17: ["settings-panel"],
}

# Held with L2, a button does its second thing. Brightness lives here rather
# than on a button of its own: the front of the device is for what you reach for
# without thinking, and how bright the screen is is not that.
CARRIED_KEYS = {
    e.KEY_LEFT:  ["/usr/local/bin/legion-brightness", "down"],
    e.KEY_RIGHT: ["/usr/local/bin/legion-brightness", "up"],
}

BUTTONS = {
    e.BTN_MODE:   ["launcher"],
    e.BTN_START:  ["/usr/local/bin/legion-buttons", "--menu"],
    e.BTN_SELECT: ["hyprctl", "dispatch",
                   'hl.dsp.focus({workspace = "previous"})'],

}

# The shoulders move between workspaces. Hold L2 and they carry the window with
# you instead, which is the only way to move a window somewhere else without a
# keyboard.
SHOULDERS = {e.BTN_TL: "-1", e.BTN_TR: "+1"}

CARRY_HELD = 0.5  # how far L2 must be pulled to count as held


def workspace(where, carrying):
    verb = "hl.dsp.window.move" if carrying else "hl.dsp.focus"
    run(["hyprctl", "dispatch", '%s({workspace = "%s"})' % (verb, where)])


def run(argv):
    try:
        subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as exc:
        print("cannot run %s: %s" % (argv[0], exc), file=sys.stderr)


def told(variable):
    """A device this was told to read, rather than one it went looking for.

    Nothing sets these on the Legion Go, where looking is the right way round:
    the pad's path changes every time a profile is reloaded. They are how the
    emulator points this at the devices it made, on a machine that has a
    touchpad and a keyboard of its own that answer to the same description.
    """
    path = os.environ.get(variable)
    if not path:
        return None
    try:
        return evdev.InputDevice(path)
    except OSError as exc:
        print("%s: %s" % (variable, exc), file=sys.stderr)
        return None


def find_touchpad():
    """The controller's touchpad, which nothing else is reading."""
    told_to = told("LEGION_TOUCHPAD")
    if told_to is not None:
        return told_to
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
        except OSError:
            continue
        keys = dev.capabilities().get(e.EV_KEY, [])
        codes = [c for c, _ in dev.capabilities().get(e.EV_ABS, [])]
        if e.BTN_TOUCH in keys and e.ABS_X in codes and "touchpad" in dev.name.lower():
            return dev
        dev.close()
    return None


def find_keyboard():
    """The keyboard InputPlumber publishes, where the back buttons arrive."""
    told_to = told("LEGION_KEYS")
    if told_to is not None:
        return told_to
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
        except OSError:
            continue
        keys = dev.capabilities().get(e.EV_KEY, [])
        if e.KEY_F13 in keys and e.KEY_ESC in keys and not dev.phys:
            return dev
        dev.close()
    return None


def find_gamepad():
    """The virtual pad InputPlumber publishes, not the physical controller.

    Both carry a right stick and both call themselves an Xbox pad, so the name
    settles nothing. The physical one is grabbed by InputPlumber and would
    report nothing for as long as we held it.

    A device made through uinput has no physical location, and a real one does.
    That is the difference, and unlike a name it cannot be shared.
    """
    told_to = told("LEGION_PAD")
    if told_to is not None:
        return told_to
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
        except OSError:
            continue
        codes = [c for c, _ in dev.capabilities().get(e.EV_ABS, [])]
        if e.ABS_RX in codes and e.ABS_RY in codes and not dev.phys:
            return dev
        dev.close()
    return None


def normalise(dev, code, value):
    info = dev.absinfo(code)
    span = max(abs(info.max), abs(info.min)) or 1
    v = value / span
    if abs(v) < DEADZONE:
        return 0.0
    # Rescale so motion starts at the edge of the deadzone, and square it so
    # small pushes stay slow and precise.
    v = (abs(v) - DEADZONE) / (1.0 - DEADZONE)
    return (v * v) if value > 0 else -(v * v)


def main():
    pad = find_gamepad()
    if pad is None:
        print("stick-scroll: no gamepad with a right stick found", file=sys.stderr)
        return 1
    print("stick-scroll: reading %s (%s)" % (pad.name, pad.path), file=sys.stderr)

    pad_touch = find_touchpad()
    if pad_touch is not None:
        print("stick-scroll: reading %s (%s)" % (pad_touch.name, pad_touch.path),
              file=sys.stderr)

    out = UInput(
        {
            e.EV_REL: [e.REL_WHEEL, e.REL_HWHEEL, e.REL_X, e.REL_Y],
            e.EV_KEY: [e.BTN_LEFT],
        },
        name="stick-scroll",
        version=1,
    )

    touch = {"down": False, "x": None, "y": None,
             "started": 0.0, "travel": 0.0, "held": False}
    owed_x = owed_y = 0.0     # movement too small to send yet
    looked = 0.0              # when the touchpad was last looked for
    hunted = 0.0              # when the gamepad was last looked for

    keys = find_keyboard()
    if keys is not None:
        print("stick-scroll: reading %s (%s)" % (keys.name, keys.path),
              file=sys.stderr)

    x = y = 0.0
    carrying = False
    debt_x = debt_y = 0.0
    last = time.monotonic()

    while True:
        # Drain whatever the pad has without blocking. There may be no pad:
        # a profile with no gamepad among its targets takes it away for as
        # long as that profile is loaded, this loop goes on serving the
        # touchpad and the back buttons while it is gone, and reading from
        # nothing in between is what used to end the process and take the
        # workspace buttons with it.
        try:
            for ev in pad.read() if pad is not None else ():
                if ev.type not in (e.EV_ABS, e.EV_KEY):
                    continue
                if ev.type == e.EV_ABS and ev.code in (e.ABS_Z, e.ABS_HAT2Y):
                    info = pad.absinfo(ev.code)
                    span = info.max - info.min or 1
                    carrying = (ev.value - info.min) / span > CARRY_HELD
                    continue

                if ev.type == e.EV_KEY:
                    if ev.value == 1:
                        name = e.BTN.get(ev.code, ev.code)
                        if isinstance(name, (list, tuple)):
                            name = "/".join(name)
                        print("button %s (%d)" % (name, ev.code),
                              file=sys.stderr, flush=True)
                    if ev.value == 1 and ev.code == e.BTN_TL2:
                        carrying = True
                    elif ev.value == 0 and ev.code == e.BTN_TL2:
                        carrying = False
                    if ev.value == 1 and ev.code in SHOULDERS:
                        workspace(SHOULDERS[ev.code], carrying)
                        continue
                    if ev.value == 1 and ev.code in BUTTONS:
                        run(BUTTONS[ev.code])
                    continue
                if ev.code == e.ABS_RX:
                    x = normalise(pad, e.ABS_RX, ev.value)
                elif ev.code == e.ABS_RY:
                    y = normalise(pad, e.ABS_RY, ev.value)
        except BlockingIOError:
            pass
        except OSError:
            # The pad went away, which a profile switch does every time.
            # Reading from nothing is what used to kill this process, and it
            # took the workspace buttons with it.
            pad = None
            x = y = 0.0

        # Look for it again, but never sit here waiting. A menu holds the pad
        # away for as long as it is open, and everything else this loop reads,
        # the touchpad above all, has to keep working while it does.
        if pad is None and time.monotonic() - hunted > 1.0:
            hunted = time.monotonic()
            pad = find_gamepad()
            if pad is not None:
                print("stick-scroll: pad came back at %s" % pad.path,
                      file=sys.stderr, flush=True)

        # The back buttons and Legion right, on the keyboard side. A profile
        # switch takes this device away too, so it is picked up again the same
        # way the pad is.
        try:
            if keys is not None:
                for ev in keys.read():
                    if ev.type != e.EV_KEY or ev.value != 1:
                        continue
                    if carrying and ev.code in CARRIED_KEYS:
                        run(CARRIED_KEYS[ev.code])
                    elif ev.code in KEYS:
                        run(KEYS[ev.code])
        except BlockingIOError:
            pass
        except OSError:
            keys = None
        if keys is None:
            keys = find_keyboard()

        # The touchpad. Position in, movement out: what matters is how far the
        # finger went since the last report, not where it landed.
        try:
            if pad_touch is not None:
                dx = dy = 0
                for ev in pad_touch.read():
                    if ev.type == e.EV_KEY and ev.code == e.BTN_TOUCH:
                        if ev.value == 1:
                            touch.update(down=True, x=None, y=None,
                                         started=time.monotonic(), travel=0.0)
                        else:
                            touch["down"] = False
                            quick = time.monotonic() - touch["started"] < TAP_SECONDS
                            if quick and touch["travel"] < TAP_TRAVEL:
                                out.write(e.EV_KEY, e.BTN_LEFT, 1)
                                out.syn()
                                out.write(e.EV_KEY, e.BTN_LEFT, 0)
                                out.syn()
                    elif ev.type == e.EV_KEY and ev.code == e.BTN_0:
                        # Pressing the pad in, rather than tapping it.
                        touch["held"] = ev.value == 1
                        out.write(e.EV_KEY, e.BTN_LEFT, ev.value)
                        out.syn()
                    elif ev.type == e.EV_ABS and touch["down"]:
                        axis = "x" if ev.code == e.ABS_X else \
                               "y" if ev.code == e.ABS_Y else None
                        if axis is None:
                            continue
                        previous = touch[axis]
                        touch[axis] = ev.value
                        if previous is None:
                            continue
                        step = ev.value - previous
                        touch["travel"] += abs(step)
                        if axis == "x":
                            dx += step
                        else:
                            dy += step
                if TOUCH_SWAP:
                    dx, dy = dy, dx
                if TOUCH_FLIP_X:
                    dx = -dx
                if TOUCH_FLIP_Y:
                    dy = -dy

                # Keep what the gain leaves behind, or a slow drag rounds to
                # nothing and the pointer refuses to move at all.
                owed_x += dx * TOUCH_GAIN
                owed_y += dy * TOUCH_GAIN
                if abs(owed_x) >= 1.0 or abs(owed_y) >= 1.0:
                    out.write(e.EV_REL, e.REL_X, int(owed_x))
                    out.write(e.EV_REL, e.REL_Y, int(owed_y))
                    out.syn()
                    owed_x -= int(owed_x)
                    owed_y -= int(owed_y)
        except BlockingIOError:
            pass
        except OSError:
            pad_touch = None
        if pad_touch is None and time.monotonic() - looked > 1.0:
            looked = time.monotonic()
            pad_touch = find_touchpad()

        now = time.monotonic()
        dt, last = now - last, now

        debt_y += -y * MAX_HZ * dt    # push up, page goes up
        debt_x += x * MAX_HZ * dt

        moved = False
        while abs(debt_y) >= 1.0:
            step = 1 if debt_y > 0 else -1
            out.write(e.EV_REL, e.REL_WHEEL, step)
            debt_y -= step
            moved = True
        while abs(debt_x) >= 1.0:
            step = 1 if debt_x > 0 else -1
            out.write(e.EV_REL, e.REL_HWHEEL, step)
            debt_x -= step
            moved = True
        if moved:
            out.syn()

        # A finger on the pad is read at the pad's own pace. Anything slower
        # arrives as a series of jumps, which reads as a slow machine.
        time.sleep(TOUCH_POLL if touch["down"] else POLL)


if __name__ == "__main__":
    sys.exit(main())
