#!/bin/sh
# Hand the session's environment to systemd, then start the desktop.
#
# Everything that makes up this desktop is a user service rather than something
# the compositor launches and forgets. One place decides what runs, it is the
# same after every reboot, and anything that dies comes back by itself.
systemctl --user import-environment \
    WAYLAND_DISPLAY \
    HYPRLAND_INSTANCE_SIGNATURE \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_TYPE \
    XDG_RUNTIME_DIR

# Restarted rather than started. These services outlive the compositor, and
# what they were told about it on the way in is a socket that a new one does
# not answer on: a desktop that came back would be driven by services still
# talking to the one before it.
exec systemctl --user restart --no-block console.target
