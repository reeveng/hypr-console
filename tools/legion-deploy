#!/bin/sh
# Put this checkout on the Legion Go and bring the machine to match it.
#
#     tools/legion-deploy --check    what would change, and change nothing
#     tools/legion-deploy            that, then ask, then apply
#     tools/legion-deploy --yes      that, without asking
#
# The device's /etc/legion is a git repository and this pushes into it, so the
# history of what the desktop is made of stays one history whether a change was
# made here or made there and saved. Everything after the push is the machine's
# own `legion` doing what it always does.
set -e

host=${LEGION_HOST:-root@handheld}
here=$(cd "$(dirname "$0")/.." && pwd)
cd "$here"

if [ -n "$(git status --porcelain)" ]; then
    echo "there are changes here that are not committed:" >&2
    git status --short >&2
    echo "commit them first: what is deployed is what is in the history" >&2
    exit 1
fi

echo "== the tests, before anything is sent"
make --no-print-directory test

echo
echo "== what the device has that this does not"
git fetch --quiet "ssh://$host/etc/legion" master
if [ -n "$(git log --oneline HEAD..FETCH_HEAD)" ]; then
    git log --oneline HEAD..FETCH_HEAD
    echo "pull those first: tools/legion-pull" >&2
    exit 1
fi
echo "  nothing"

echo
echo "== what this has that the device does not"
git log --oneline FETCH_HEAD..HEAD || true
git diff --stat FETCH_HEAD..HEAD || true

case "$1" in
--check)
    echo
    echo "== what the machine would say about itself"
    ssh "$host" legion check || true
    exit 0
    ;;
esac

if [ "$1" != "--yes" ]; then
    printf '\napply this to %s? [y/N] ' "$host"
    read -r answer
    case "$answer" in y | Y | yes) ;; *) echo "nothing sent"; exit 1 ;; esac
fi

# A push into a repository with a working tree is refused unless it is told to
# update the tree as well, and it is still refused if that tree has changes of
# its own, which is the protection worth keeping: a `legion save` nobody
# committed is not overwritten from here.
ssh "$host" git -C /etc/legion config receive.denyCurrentBranch updateInstead
git push "ssh://$host/etc/legion" HEAD:master

# The engine is the one file the manifest does not list, because a program
# that copies over the file it is being read from can be halfway through
# itself when it changes. So it is put there from here, by something that is
# not it, before it is asked to do anything. Without this the device keeps
# whatever engine it was given the day it was set up, and every later
# improvement to `apply` sits in the history doing nothing.
ssh "$host" install -m 755 /etc/legion/files/usr/local/bin/legion /usr/local/bin/legion
ssh "$host" legion apply
