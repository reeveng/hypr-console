#!/usr/bin/env python3
"""Write down what an input device is, so somewhere else can pretend to be it.

Run on the Legion Go. Every device the controller daemon looks for is dumped as
JSON, and `emulator/` builds a device from that JSON through uinput. What the
daemon then finds is the same shape as the real thing: the same name, the same
axes, the same ranges, and no physical location, which is the one difference
between a real pad and the one InputPlumber publishes.
"""

import json
import sys

import evdev
from evdev import ecodes as e

# The devices the daemon reads, by the name the kernel gives them.
WANTED = [
    "Microsoft X-Box One Elite 2 pad",
    "InputPlumber Keyboard",
    "InputPlumber Mouse",
    "  Legion Controller  Touchpad",
]


def describe(dev):
    caps = dev.capabilities(absinfo=True)
    out = {
        "name": dev.name,
        "phys": dev.phys or "",
        "uniq": dev.uniq or "",
        "vendor": dev.info.vendor,
        "product": dev.info.product,
        "version": dev.info.version,
        "bustype": dev.info.bustype,
        "properties": sorted(dev.input_props()),
        "capabilities": {},
    }
    for kind, codes in caps.items():
        if kind == e.EV_SYN:
            continue
        if kind == e.EV_ABS:
            out["capabilities"]["EV_ABS"] = [
                {
                    "code": code,
                    "min": info.min,
                    "max": info.max,
                    "fuzz": info.fuzz,
                    "flat": info.flat,
                    "resolution": info.resolution,
                }
                for code, info in codes
            ]
        else:
            name = e.EV[kind]
            out["capabilities"][name] = sorted(
                c for c in codes if isinstance(c, int)
            )
    return out


def main():
    found = {}
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
        except OSError:
            continue
        if dev.name in WANTED and dev.name not in found:
            found[dev.name] = describe(dev)
        dev.close()

    missing = [n for n in WANTED if n not in found]
    if missing:
        print("not present: %s" % ", ".join(missing), file=sys.stderr)

    json.dump([found[n] for n in WANTED if n in found], sys.stdout,
              indent=2, sort_keys=True)
    print()
    return 1 if missing else 0


if __name__ == "__main__":
    sys.exit(main())
