// run-rustfix
// edition:2024

#[cfg(any(target_arch = "x86", target_arch = "x86_64"))]
mod simd {
    pub fn word(bytes: [u8; 4]) -> i32 {
        i32::from_le_bytes(bytes)
    }
}

#[cfg(all(target_endian = "little", target_pointer_width = "64"))]
fn samples(word: u16) -> [u8; 2] {
    u16::to_le_bytes(word)
}

#[cfg(target_endian = "big")]
fn samples(word: u16) -> [u8; 2] {
    word.to_ne_bytes()
}

fn one_byte(value: i8) -> i8 {
    i8::from_le_bytes(value.to_le_bytes())
}

fn main() {
    #[cfg(any(target_arch = "x86", target_arch = "x86_64"))]
    assert_eq!(simd::word([1, 2, 0, 0]), 513);
    #[cfg(all(target_endian = "little", target_pointer_width = "64"))]
    assert_eq!(samples(0x0302), [2, 3]);
    assert_eq!(one_byte(-1), -1);
}
