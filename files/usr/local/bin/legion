#!/usr/bin/env python3
"""Bring this machine to match /etc/legion/desktop.conf.

    legion list      what the desktop is made of
    legion check     where the machine has drifted from it
    legion apply     bring the machine back to it
    legion save      take a file edited in place back into the source

The manifest is the source of truth and this is only the engine that reads it.
Anything installed or enabled outside it is invisible here, which is the point:
a desktop assembled by hand is one nobody can put back together.
"""

import os
import pwd
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path("/etc/legion")
SOURCE = ROOT / "files"
MANIFEST = ROOT / "desktop.conf"
USER = "player"

# Named by number, so they are whatever this terminal's palette says. The dim
# attribute is not among them: it halves whatever colour it is applied to, and
# half of a colour chosen to clear 7:1 is a colour that does not.
GREEN, RED, YELLOW, QUIET, OFF = "\033[32m", "\033[31m", "\033[33m", "\033[37m", "\033[0m"


def read_manifest():
    """The manifest as {section: [entry]}, comments and blank lines dropped."""
    sections, current = {}, None
    for line in MANIFEST.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            current = line[1:-1]
            sections[current] = []
        elif current:
            sections[current].append(line)
    return sections


def owner_of(path):
    """Files under a user's home belong to that user. Everything else is root's."""
    return USER if str(path).startswith(f"/home/{USER}/") else "root"


def mode_of(source):
    """Whether a file is meant to be run.

    A script says so with a shebang and a compiled program with its own magic
    number, and anything kept in a bin directory is there to be run whatever it
    is made of. Reading only the first two bytes got this wrong for a compiled
    program, which was then installed unreadable to the kernel and refused to
    start with nothing but "permission denied" to say why.
    """
    if "/bin/" in str(source) or "/sbin/" in str(source):
        return 0o755
    with open(source, "rb") as handle:
        head = handle.read(4)
    return 0o755 if head[:2] == b"#!" or head == b"\x7fELF" else 0o644


def user_systemctl(*args):
    """systemctl for the desktop user's own manager, from a root shell."""
    return ["systemctl", "--user", "-M", f"{USER}@", *args]


def run(argv, check=True):
    return subprocess.run(argv, check=check, capture_output=True, text=True)


def installed_packages():
    out = run(["pacman", "-Qq"], check=False).stdout
    return set(out.split())


def file_state(path):
    """One of missing, differs, ok, or unsourced."""
    source, live = SOURCE / str(path).lstrip("/"), Path(path)
    if not source.exists():
        return "unsourced"
    if not live.exists():
        return "missing"
    if source.read_bytes() != live.read_bytes():
        return "differs"
    return "ok"


def unit_state(unit):
    enabled = run(user_systemctl("is-enabled", unit), check=False).stdout.strip()
    active = run(user_systemctl("is-active", unit), check=False).stdout.strip()
    return enabled, active


def cmd_list(manifest):
    for section, entries in manifest.items():
        print(f"{YELLOW}[{section}]{OFF}")
        for entry in entries:
            print(f"  {entry}")
        print()


def cmd_check(manifest):
    """Report every difference between the manifest and the machine."""
    drift = 0
    have = installed_packages()

    print(f"{YELLOW}packages{OFF}")
    for package in manifest.get("packages", []):
        ok = package in have
        drift += not ok
        mark = f"{GREEN}ok{OFF}" if ok else f"{RED}missing{OFF}"
        print(f"  {mark:>18}  {package}")

    print(f"\n{YELLOW}files{OFF}")
    for path in manifest.get("files", []):
        state = file_state(path)
        drift += state != "ok"
        colour = GREEN if state == "ok" else RED
        print(f"  {colour}{state}{OFF}".ljust(29) + f"  {path}")

    print(f"\n{YELLOW}services{OFF}")
    for unit in manifest.get("services", []):
        enabled, active = unit_state(unit)
        ok = enabled == "enabled" and active == "active"
        drift += not ok
        colour = GREEN if ok else RED
        print(f"  {colour}{enabled}, {active}{OFF}".ljust(29) + f"  {unit}")

    print(f"\n{YELLOW}masked{OFF}")
    for unit in manifest.get("masked", []):
        enabled, _ = unit_state(unit)
        ok = enabled == "masked"
        drift += not ok
        colour = GREEN if ok else RED
        print(f"  {colour}{enabled or 'not masked'}{OFF}".ljust(29) + f"  {unit}")

    print()
    if drift:
        print(f"{RED}{drift} differences.{OFF} `legion apply` settles them.")
    else:
        print(f"{GREEN}The machine matches the manifest.{OFF}")
    return 1 if drift else 0


def install_file(path):
    """Write beside the destination, then move it into place.

    Writing over the destination fails outright for a program that is running:
    the kernel refuses to alter a file being executed. A rename replaces the
    name rather than the file, which the running copy holds on to until it
    exits. It is also all-or-nothing, so an interrupted apply cannot leave half
    a file behind.
    """
    source, live = SOURCE / str(path).lstrip("/"), Path(path)
    live.parent.mkdir(parents=True, exist_ok=True)
    staged = live.with_name(live.name + ".legion-new")
    shutil.copyfile(source, staged)
    os.chmod(staged, mode_of(source))
    owner = pwd.getpwnam(owner_of(path))
    os.chown(staged, owner.pw_uid, owner.pw_gid)
    os.replace(staged, live)


# A program that reads a file once, when it starts, has to be told the file
# changed. Writing it and saying "Done." leaves the machine looking applied
# and behaving as it did before, which is worse than not writing it at all:
# the next person to look believes the new file is what is running.
# Only what has been watched doing it. The compositor belongs here too and
# is not here yet: `hyprctl reload` wants the running instance named, and
# an entry that quietly does nothing is the fault this table is for.
WAKES = [
    ("/.config/waybar/", "pkill -SIGUSR2 -x waybar", "the bar"),
]


def started_by(unit):
    """The programs a unit runs, so that rewriting one restarts it."""
    text = (SOURCE / ("etc/systemd/user/" + unit).lstrip("/")).read_text()
    return set(re.findall(r"^Exec\w+=-?(\S+)", text, re.M))


def wake(written):
    """Tell whatever was reading a file that it is not the file any more."""
    for prefix, command, name in WAKES:
        if not any(prefix in path for path in written):
            continue
        print(f"{YELLOW}reloading{OFF} {name}")
        run(["su", USER, "-c", command], check=False)


def cmd_apply(manifest):
    if os.geteuid() != 0:
        sys.exit("legion apply has to run as root.")

    missing = [p for p in manifest.get("packages", []) if p not in installed_packages()]
    if missing:
        print(f"{YELLOW}installing{OFF} {' '.join(missing)}")
        subprocess.run(["pacman", "-S", "--needed", "--noconfirm", *missing], check=True)

    written = []
    units_changed = False
    for path in manifest.get("files", []):
        state = file_state(path)
        if state == "unsourced":
            print(f"{RED}no source for{OFF} {path}")
            continue
        if state == "ok":
            continue
        print(f"{YELLOW}writing{OFF} {path}")
        install_file(path)
        written.append(path)
        units_changed |= "/systemd/" in path

    if units_changed:
        run(user_systemctl("daemon-reload"))

    for unit in manifest.get("services", []):
        enabled, active = unit_state(unit)
        if enabled != "enabled":
            print(f"{YELLOW}enabling{OFF} {unit}")
            run(user_systemctl("enable", unit), check=False)
        if active != "active":
            print(f"{YELLOW}starting{OFF} {unit}")
            run(user_systemctl("start", unit), check=False)
        elif written and ("/etc/systemd/user/" + unit in written
                          or started_by(unit) & set(written)):
            print(f"{YELLOW}restarting{OFF} {unit}")
            run(user_systemctl("restart", unit), check=False)

    for unit in manifest.get("masked", []):
        if unit_state(unit)[0] != "masked":
            print(f"{YELLOW}masking{OFF} {unit}")
            run(user_systemctl("mask", unit), check=False)

    wake(written)
    commit("apply")
    print(f"\n{GREEN}Done.{OFF}")
    return 0


def cmd_save(manifest, paths):
    """Take a file that was edited in place back into the source tree.

    Editing the live file is the natural thing to do while chasing a fault. The
    next apply would put it back, so this is how that edit is kept.
    """
    wanted = paths or [p for p in manifest.get("files", []) if file_state(p) == "differs"]
    if not wanted:
        print("Nothing differs from the source.")
        return 0
    for path in wanted:
        live = Path(path)
        if not live.exists():
            print(f"{RED}not on the machine{OFF} {path}")
            continue
        source = SOURCE / str(path).lstrip("/")
        source.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(live, source)
        print(f"{YELLOW}saved{OFF} {path}")
    commit("save")
    return 0


def commit(what):
    """Keep a history, so a desktop that breaks can be walked back."""
    if not (ROOT / ".git").exists():
        return
    run(["git", "-C", str(ROOT), "add", "-A"], check=False)
    status = run(["git", "-C", str(ROOT), "status", "--porcelain"], check=False).stdout
    if status.strip():
        run(["git", "-C", str(ROOT), "commit", "-m", what], check=False)


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "check"
    manifest = read_manifest()
    if command == "list":
        return cmd_list(manifest)
    if command == "check":
        return cmd_check(manifest)
    if command == "apply":
        return cmd_apply(manifest)
    if command == "save":
        return cmd_save(manifest, sys.argv[2:])
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main() or 0)
