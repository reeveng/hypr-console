// run-rustfix
// edition:2024
#![allow(dead_code)]

fn middle(values: &mut [u8; 8]) -> &mut [u8] {
    { let [_, _, _explicit_part @ .., _, _] = &mut *values; let _explicit_slice: &mut [_] = _explicit_part; _explicit_slice }
}

fn prefix(values: &[u8; 8]) -> &[u8] {
    { let [_explicit_part @ .., _, _, _, _] = &*values; let _explicit_slice: &[_] = _explicit_part; _explicit_slice }
}

fn empty(values: &[u8; 8]) -> &[u8] {
    { let [_, _, _, _explicit_part @ .., _, _, _, _, _] = &*values; let _explicit_slice: &[_] = _explicit_part; _explicit_slice }
}

fn end_of_row(values: &[String; 64]) -> &String {
    { let [.., _explicit_part, _] = &*values; _explicit_part }
}

fn stored(block: &mut [[u8; 4]; 64]) {
    *{ let [.., [_, _explicit_part, ..]] = &mut *block; _explicit_part } = 7;
}

fn last(values: [u8; 32]) -> u8 {
    let [.., last] = values;
    last
}

fn main() {
    let mut values = [0, 1, 2, 3, 4, 5, 6, 7];
    assert_eq!(prefix(&values), &[0, 1, 2, 3]);
    assert_eq!(empty(&values).as_ptr(), values.as_ptr().wrapping_add(3));
    middle(&mut values).fill(10);
    assert_eq!(values, [0, 1, 10, 10, 10, 10, 6, 7]);
}
