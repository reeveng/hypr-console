[Unit]
Description=The background
PartOf=legion.target

[Service]
# awww keeps every decoded frame of an animation in a cache file named after
# the picture's path, its size, and how it was fitted. Nothing in that name
# comes from what is inside the file, so a redrawn background at the same path
# is served out of the frames of the old one: the still it decodes is the new
# picture and the differences it plays on top of it are the old picture's, and
# the screen fills with blocks of the two mixed together. Thrown away here
# rather than after the fact, because this is the moment the picture is about
# to be read again anyway.
ExecStartPre=-/usr/bin/rm -rf %h/.cache/awww

# The daemon tells systemd when it is ready, so the picture is only asked for
# once there is something listening to be asked. Setting it from the unit
# rather than from a login script means the background is on the machine's
# inventory like everything else, and comes back with the service.
Type=notify
ExecStart=/usr/bin/awww-daemon
ExecStartPost=/usr/bin/awww img /usr/share/backgrounds/legion.webp --resize crop --transition-type none
Restart=always
RestartSec=2

[Install]
WantedBy=legion.target
