[Unit]
Description=Controller
PartOf=console.target

[Service]
Type=simple
ExecStart=/usr/local/bin/controller-desktop
# Tolerated, because the daemon above is not only the pad. It renders the
# keyboard half of the same table and hands it to the compositor -- every key on
# this desktop is a bind this process sent -- so a unit that fails is a machine
# with no keys either. A machine with no pad in it now says so and stops well,
# having read the kernel's list of devices before it asked any bus, so the
# minute that used to be spent here every login is gone. What the `-` is still
# for is the other machine: one with a pad whose InputPlumber never comes up.
# That is a real failure and is still reported as one, and without the `-` it
# would be the unit's, `Restart=always` would kill the daemon, and the whole
# thing would go round again every minute -- taking the keyboard with it each
# time.
ExecStartPost=-/usr/local/bin/controller-profile router
# A profile switch destroys and recreates the pad. The daemon waits for a new
# one, but if it ever dies for another reason it must not stay dead: losing it
# silently takes the workspace and close buttons with it.
ExecStopPost=-/usr/local/bin/console-report-crash %n
Restart=always
RestartSec=2

# What this reaches past `console-.service.d/confining.conf`, and why.
#
# /dev/input is the whole of this program's job and /dev/uinput is where its
# own pointer comes from, so a private /dev is the one line that could never be
# here. The home directory stays because the daemon stamps the waits store in
# it. What is left is a program that reads buttons and talks to the compositor,
# and neither of those is off this machine.
#
# `RestrictAddressFamilies=AF_UNIX AF_NETLINK` was that line and it is gone.
# It is seccomp, and a seccomp of any kind on a unit of an unprivileged manager
# is `NoNewPrivileges=` on the process however the flag is written -- see the
# paragraph in `confining.conf`. The left Legion button crosses to Game Mode
# with `pkexec`, so this unit is one of the two that cannot carry it.

[Install]
WantedBy=console.target
