// run-rustfix

// UI test for EXPLICIT009 — a discarded `#[must_use]` value must be
// discarded in writing.

#[must_use]
fn counted() -> i32 {
    1
}

// BAD EXPLICIT009 — thrown away silently.
fn silent() {
    //~v EXPLICIT009_EXPLICIT_DISCARD
    let _ = counted();
}

// GOOD — the discard is a decision someone wrote down.
fn deliberate() {
    let _ = counted();
}

// GOOD — used.
fn used() -> i32 {
    counted() + 1
}

struct Meter;

impl Meter {
    #[must_use]
    fn read(&self) -> u8 {
        2
    }
}

fn discard_method() {
    let _ = Meter.read();
}

fn main() {
    silent();
    deliberate();
    let _ = used();
    discard_method();
}
