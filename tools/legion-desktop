#!/usr/bin/env python3
"""The Legion Go's desktop, running on this machine, in a window.

    tools/legion-desktop verify     does the compositor config still parse
    tools/legion-desktop run        the desktop, nested, at the device's size
    tools/legion-desktop shot FILE  a picture of it
    tools/legion-desktop clean      forget what nobody is using

The device is a screen you have to pick up and a session you have to log into.
Most of what is worth looking at, the bar, the menu, the keyboard, the panel,
the colours everything wears, is ordinary Wayland software reading ordinary
config files, and this machine can run all of it. So it does: a compositor of
its own, inside a window, at the size the device's screen actually is, reading
the files the device reads.

What it is not is the device. Read `## What this is not` in docs/desktop.md
before trusting it about anything.

The staged copy is the whole of the trick. Every file the desktop reads is
copied out of files/ into one directory of this session's own, and every
absolute path inside those files is rewritten to point back into it. So a
stylesheet that says /usr/share/backgrounds/legion.webp finds the picture that
is going to be installed there, without this machine having a
/usr/share/backgrounds it is allowed to write to. The copy is deleted when the
command ends, so there is nothing in it worth being careful with.
"""

import argparse
import atexit
import fcntl
import importlib.machinery
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from harness.screen import Screen, where                        # noqa: E402

REPO = Path(__file__).resolve().parent.parent
FILES = REPO / "files"
STAGES = REPO / ".stage"

# One session's copy, and no other session's. Several of these run on this
# machine at once, and the first thing staging does is delete what was there,
# so one path shared between them is one session deleting the desktop another
# is in the middle of photographing. The name carries the process it belongs
# to, which is also how one left behind by a session that has ended is
# recognised. Set LEGION_STAGE to keep a copy of your own that survives the
# command and is never swept up.
STAGE = STAGES / (os.environ.get("LEGION_STAGE") or "session-%d" % os.getpid())
HOME = "/home/player"

# The device's screen, read out of the file the device reads: the mode, the
# quarter turn and the density everything is drawn at. Nothing here is a
# number about the screen; harness/screen.py has them all, once.
SCREEN = Screen()
WIDTH, HEIGHT = SCREEN.logical

# How much of this machine's screen a window may take before it is worth
# giving density up to fit. A picture of the device is 2560x1600, which is
# larger than most laptops.
ROOM = 0.9

# What the compositor starts on the device is a systemd target, and the four
# services under it belong to that machine's session. Starting them here would
# reach into this machine's own systemd, so the staged copy of session-start
# runs the same programs directly instead.
SESSION_START = """#!/bin/sh
# The staged stand-in for session-start. On the device this hands the
# environment to systemd and starts legion.target; here the four pieces are
# started directly, because this machine's systemd is not the device's.
[ -x "$(command -v waybar)" ] && waybar &
[ -x "$(command -v awww-daemon)" ] && { awww-daemon & sleep 1; \
  awww img /usr/share/backgrounds/legion.webp --resize crop --transition-type none; }
# Through osk-start, which is what the device starts it with, because wvkbd
# takes its colours as arguments and osk-start is the one thing that turns the
# palette into them. Started here any other way, the keyboard on this screen
# would be a keyboard nobody has, in colours that were true once.
[ -x "$(command -v osk-start)" ] && osk-start &
exit 0
"""

NESTED = """-- The device's compositor config, with its screen swapped for this one.
--
-- Nothing else is changed. The window rules, the bindings, the look and the
-- absence of animation are all read from the file the device reads, so a
-- change tried here is a change tried there.

%s

dofile("%s")

-- Said again after the device's config, because that one names the screen the
-- device is mounted on and this is not that screen.
hl.monitor({ output = "eDP-1", disabled = true })

-- On the device the bare background is the darkest colour in the palette, so
-- that a wallpaper arriving a second after the compositor does not announce
-- itself with a flash of something else. Here that is the one colour it must
-- not be: the wallpaper rests at that same colour, so a screen nothing painted
-- and a screen the garden painted would read alike, and a check comparing them
-- would pass with no wallpaper at all. Nothing is ever this.
hl.config({ misc = { background_color = "rgb(ff00ff)" } })
"""

# A compositor running as somebody else's window gets one output and calls it
# WAYLAND-1, at whatever size the host gave the window. That is the one to have
# while looking at something and pressing things.
IN_A_WINDOW = '''hl.monitor({
    output    = "WAYLAND-1",
    mode      = "%dx%d@%d",
    position  = "auto",
    scale     = %s,
    transform = %d,
})'''

# For a picture, the window is in the way: its size is the host's to decide and
# the device's screen is a fixed thing. So a headless output is made at the
# size the device's screen is, and the window is turned off once it exists.
# Turning the window off first leaves nothing to draw on and nothing to
# photograph, which is what "no wl_output" meant.
HEADLESS = '''hl.monitor({
    output    = "HEADLESS-1",
    mode      = "%dx%d@%d",
    position  = "auto",
    scale     = %s,
    transform = %d,
})
hl.monitor({
    output    = "HEADLESS-2",
    mode      = "%dx%d@%d",
    position  = "auto",
    scale     = %s,
    transform = %d,
})'''



def text(path):
    try:
        return path.read_text()
    except (UnicodeDecodeError, OSError):
        return None


def installer():
    """The program that installs this on the device, imported for one rule.

    What is executable is decided there, by a shebang or an ELF header or the
    directory, because a file's mode in git is not what the device installs it
    with. Copying the modes out of the checkout instead gave a stage where
    settings-panel was not executable, so --open started nothing and the
    picture was of a desktop with no panel in it.
    """
    return importlib.machinery.SourceFileLoader(
        "legion_install", str(FILES / "usr/local/bin/legion")).load_module()


def abandoned():
    """Stages belonging to sessions that are no longer running."""
    for path in sorted(STAGES.glob("session-*")):
        pid = path.name.split("-", 1)[1]
        if pid.isdigit() and not Path("/proc", pid).exists():
            yield path


def dead_instances():
    """Runtime directories of compositors that are not there any more.

    A nested Hyprland that is killed rather than asked to leave does not tidy
    its own, and they had been piling up since the first one. A live one
    answers hyprctl; that is the whole test, and the one this session belongs
    to is left alone whatever it says.
    """
    where = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()))
    if shutil.which("hyprctl") is None:
        return
    ours = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    for path in sorted((where / "hypr").glob("*")):
        if not path.is_dir() or path.name == ours:
            continue
        answered = subprocess.run(["hyprctl", "-i", path.name, "version"],
                                  capture_output=True)
        if answered.returncode != 0:
            yield path


class starting:
    """Held while a compositor comes up, so two of them cannot be confused.

    A nested Hyprland picks its own signature and does not say what it picked,
    so the only way to learn it is to watch for one appearing. Two sessions
    starting at the same moment would each see two appear and could take the
    other's. Coming up takes a second or so; this is held for that second, and
    dropped long before the desktop is used, so sessions still run at once.
    """

    def __enter__(self):
        STAGES.mkdir(parents=True, exist_ok=True)
        self.lock = open(STAGES / "starting.lock", "w")
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        return self

    def __exit__(self, *_):
        fcntl.flock(self.lock, fcntl.LOCK_UN)
        self.lock.close()


def room_here():
    """How much of this machine's screen a window may have.

    Asked of the compositor running it rather than assumed, because the whole
    point is that the machine looking is not the machine being looked at. If
    it cannot be asked, nothing is given up and the window is the device's own
    size, which is right on a screen large enough and obvious on one that is
    not.
    """
    try:
        monitors = json.loads(subprocess.run(
            ["hyprctl", "monitors", "-j"], capture_output=True, text=True,
            timeout=10).stdout)
        wide = max(m["width"] / m["scale"] for m in monitors)
        tall = max(m["height"] / m["scale"] for m in monitors)
    except (ValueError, KeyError, OSError, subprocess.SubprocessError):
        return SCREEN.pixels
    return (wide * ROOM, tall * ROOM)


def stage(quiet=False, headless=False):
    """Every file the desktop reads, in one place, pointing at each other."""
    if STAGE.exists():
        shutil.rmtree(STAGE)
    STAGE.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(FILES / "home/player", STAGE / "home", symlinks=True)
    shutil.copytree(FILES / "usr", STAGE / "usr", symlinks=True)

    here = str(STAGE)
    for path in sorted(STAGE.rglob("*")):
        if not path.is_file() or path.is_symlink():
            continue
        was = text(path)
        if was is None:
            continue
        now = (was.replace(HOME, here + "/home")
                  .replace("/usr/local", here + "/usr/local")
                  .replace("/usr/share", here + "/usr/share"))
        if now != was:
            path.write_text(now)

    start = STAGE / "usr/local/bin/session-start"
    start.write_text(SESSION_START)

    mode_of = installer().mode_of
    for path in sorted(STAGE.rglob("*")):
        if path.is_file() and not path.is_symlink():
            path.chmod(mode_of(path))

    device_config = STAGE / "home/.config/hypr/hyprland.lua"
    nested = STAGE / "home/.config/hypr/nested.lua"
    wide, tall = SCREEN.mode
    if headless:
        # A picture of the device is the device's own pixels, all of them.
        # Nothing is given up here: this is the one that gets measured.
        screen = HEADLESS % (wide, tall, SCREEN.refresh, SCREEN.scale,
                             SCREEN.transform,
                             wide, tall, SCREEN.refresh, SCREEN.scale,
                             SCREEN.transform)
    else:
        # A window has to fit on the screen it is a window on. Density is the
        # only thing given up, and only as far as it must be: the desktop is
        # laid out in the same logical size either way, so everything is where
        # it is on the device and there are simply fewer pixels drawing it.
        scale = SCREEN.cut_to(room_here())
        shown = (round(wide * scale / SCREEN.scale),
                 round(tall * scale / SCREEN.scale))
        if not quiet and scale != SCREEN.scale:
            print("this screen cannot hold %dx%d, so the window is at a scale "
                  "of %.2f rather than the device's %s"
                  % (SCREEN.pixels + (scale, SCREEN.scale)), file=sys.stderr)
        screen = IN_A_WINDOW % (shown[0], shown[1], SCREEN.refresh, scale,
                                SCREEN.transform)
    nested.write_text(NESTED % (screen, device_config))
    if not quiet:
        print("staged in %s" % STAGE)
    return nested


def environment():
    """A session that believes the staged copy is the whole system."""
    out = dict(os.environ)
    out.update(
        HOME=str(STAGE / "home"),
        XDG_CONFIG_HOME=str(STAGE / "home/.config"),
        XDG_DATA_HOME=str(STAGE / "home/.local/share"),
        XDG_CACHE_HOME=str(STAGE / "home/.cache"),
        XDG_STATE_HOME=str(STAGE / "home/.local/state"),
        XDG_DATA_DIRS="%s:/usr/local/share:/usr/share" % (STAGE / "usr/share"),
        PATH="%s:%s" % (STAGE / "usr/local/bin", os.environ.get("PATH", "")),
    )
    return out


def verify():
    nested = stage(quiet=True)
    done = subprocess.run(["Hyprland", "--verify-config", "-c", str(nested)],
                          env=environment(), capture_output=True, text=True)
    print(done.stdout.strip() or done.stderr.strip())
    return done.returncode


def instances():
    """The Hyprlands running on this machine, by their signature."""
    where = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()))
    return {p.name for p in (where / "hypr").glob("*") if p.is_dir()}


def wait_for_instance(was, seconds=15.0):
    """The nested compositor's own signature, which is how it is spoken to.

    It picks this itself and does not say what it picked, so what is watched
    for is a new one appearing with a socket in it. Without it, hyprctl talks
    to whichever Hyprland this session belongs to, which is the one running
    the screen you are looking at.
    """
    where = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()))
    until = time.monotonic() + seconds
    while time.monotonic() < until:
        for name in sorted(instances() - was):
            if (where / "hypr" / name / ".socket.sock").exists():
                return name
        time.sleep(0.1)
    return None


def sockets():
    """The Wayland displays this machine is offering right now."""
    where = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()))
    return {p.name for p in where.glob("wayland-*") if p.suffix != ".lock"}


def wait_for_socket(was, seconds=10.0):
    """The one the nested compositor just put down.

    It cannot be asked for by name: --socket is half of the handover pair and
    Hyprland refuses it alone. So it names itself, and this waits to see which
    name that was.
    """
    until = time.monotonic() + seconds
    while time.monotonic() < until:
        new = sockets() - was
        if new:
            return sorted(new)[0]
        time.sleep(0.1)
    return None


def wait_for_screen(name, inside, seconds=12.0):
    """Wait until there is something to take a picture of.

    The screen is made a moment after the compositor starts, not with it, so
    everything that follows has to wait for it rather than assume it.
    """
    until = time.monotonic() + seconds
    while time.monotonic() < until:
        time.sleep(0.25)
        done = subprocess.run(["grim", "-o", name, "-"], env=inside,
                              capture_output=True)
        if done.returncode == 0:
            return True
    return False


def hyprctl(inside, *arguments):
    done = subprocess.run(["hyprctl", *arguments], env=inside,
                          capture_output=True, text=True)
    return done.stdout.strip()


def make_the_screen(inside):
    """The device's screen, and only that one: its mode, turn and density.

    Not a screen the size the desktop is laid out in. Everything drawn here is
    drawn at two and a half times that, the way it is on the device, because a
    stand-in at a density nobody uses agrees with you about how text sits and
    where a rounded edge falls.

    Done from out here rather than from the config, because a config can only
    have one handler for the compositor starting: registering a second one
    replaces the first, and the first is what starts the desktop.

    The window has to go last. Turning it off while it is the only screen
    leaves nothing to draw on, and nothing to photograph either.
    """
    hyprctl(inside, "output", "create", "headless")
    time.sleep(0.8)
    # Said now rather than in the config, because a monitor rule written for a
    # screen that does not exist yet is not applied to the one that turns up.
    hyprctl(inside, "eval",
            'hl.monitor({ output = "HEADLESS-1", mode = "%dx%d@%d", '
            'position = "auto", scale = %s, transform = %d })'
            % (SCREEN.mode + (SCREEN.refresh, SCREEN.scale, SCREEN.transform)))
    time.sleep(0.5)
    hyprctl(inside, "eval", 'hl.monitor({ output = "WAYLAND-1", disabled = true })')
    time.sleep(0.5)


def surfaces(inside):
    """Everything on the screen: the windows, and the layers over and under.

    A menu here is not a window. The panel, the guide and the keyboard are all
    layer surfaces, which is most of what somebody using this device touches,
    so anything that waits for a window to appear waits for ever.
    """
    on = set()
    try:
        on |= {client["address"]
               for client in json.loads(hyprctl(inside, "clients", "-j"))}
        for screen in json.loads(hyprctl(inside, "layers", "-j")).values():
            for level in screen["levels"].values():
                on |= {layer["address"] for layer in level}
    except (ValueError, KeyError, TypeError):
        pass
    return on


def wait_for_something(inside, was, seconds=20.0):
    """Wait until what was asked for has put something on the screen.

    This used to be a sleep long enough for a window, which is a guess in both
    directions: too long for a terminal, and too short for a panel that reads
    the controller before it draws anything. What it is waiting for is a fact
    it can ask about.
    """
    until = time.monotonic() + seconds
    while time.monotonic() < until:
        if surfaces(inside) - was:
            time.sleep(0.6)     # drawn, not only mapped
            return True
        time.sleep(0.2)
    return False


def show_a_window(inside):
    """Look at whatever was opened.

    Every window on this desktop opens on an empty workspace of its own, which
    is the whole point of it: there is never a second window to share a screen
    with. It also means a window that has just opened is not necessarily the
    one being looked at, and a picture of the workspace it is not on is a
    picture of nothing.
    """
    try:
        clients = json.loads(hyprctl(inside, "clients", "-j"))
    except (ValueError, TypeError):
        return
    if not clients:
        return
    where = clients[0]["workspace"]["name"]
    hyprctl(inside, "dispatch", 'hl.dsp.focus({workspace = "%s"})' % where)
    time.sleep(0.6)


def say_the_colours(shot, sample):
    """What colour the screen is where it was asked about.

    A screenshot nobody looks at agrees with anything. The
    wallpaper on the device had not painted for days: hyprpaper
    read a config it no longer understood, painted nothing, and
    reported success. What was on screen was the compositor's own
    default, dark enough to pass for a background.
    """
    if not sample:
        return
    from harness.picture import Picture
    picture = Picture(shot)
    for place in sample:
        if place == "most":
            print("  most of it   #%s" % picture.commonest())
            continue
        x, y = (int(n) for n in place.split(","))
        print("  %-12s #%s" % ("%d,%d" % (x, y), where(picture, x, y, SCREEN)))


def say_what_died(opened):
    """A program asked for that is not there any more, and what it said.

    Sent to nowhere, a program that cannot start leaves a picture of a desktop
    without it and no reason why, and the picture is what gets believed.
    """
    for command, process, said in opened:
        if process.poll() is None:
            continue
        said.seek(0)
        print("%s ended with %d: %s"
              % (command, process.returncode, said.read().strip() or "nothing said"),
              file=sys.stderr)


def paint_the_background(inside):
    """Hand the wallpaper to a screen that did not exist when it was asked.

    awww gives the picture to the outputs it can see at the moment it is told,
    and here the screen is made after the session has started, so the daemon
    comes up with nothing to paint on and stays that way. On the device the
    screen is there before anything runs and this never arises.
    """
    picture = STAGE / "usr/share/backgrounds/legion.webp"
    if shutil.which("awww") is None or not picture.exists():
        return
    # The daemon is started by the session and takes a moment to listen. Said
    # once and quietly, this failed for a week without anybody noticing,
    # because a screen with no wallpaper on it is the palette's own darkest
    # colour and looks like a screen with one.
    until = time.monotonic() + 8.0
    while time.monotonic() < until:
        told = subprocess.run(
            ["awww", "img", str(picture), "--resize", "crop",
             "--transition-type", "none"],
            env=inside, capture_output=True, text=True)
        if told.returncode == 0:
            time.sleep(0.5)
            return
        time.sleep(0.25)
    print("the wallpaper was never painted: %s" % told.stderr.strip(),
          file=sys.stderr)


def left_behind(signature):
    """The runtime directory a killed compositor does not tidy up itself."""
    where = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()))
    shutil.rmtree(where / "hypr" / signature, ignore_errors=True)


def run(shot=None, seconds=None, open_these=(), headless=True, probe=False,
        sample=()):
    nested = stage(quiet=True, headless=headless and shot is not None)
    where = environment()
    where.pop("HYPRLAND_INSTANCE_SIGNATURE", None)
    with starting():
        was, running = sockets(), instances()
        compositor = subprocess.Popen(["Hyprland", "-c", str(nested)], env=where)
        socket = wait_for_socket(was)
        signature = wait_for_instance(running)
    if socket is None or signature is None:
        print("the nested compositor never came up", file=sys.stderr)
        compositor.terminate()
        return 1
    print("the desktop is on %s" % socket, file=sys.stderr)

    if shot is None and seconds is None:
        compositor.wait()
        left_behind(signature)
        return compositor.returncode

    inside = dict(where, WAYLAND_DISPLAY=socket,
                  HYPRLAND_INSTANCE_SIGNATURE=signature)
    screen = ("HEADLESS-1" if headless else "WAYLAND-1") \
        if shot is not None or probe else None

    if headless:
        make_the_screen(inside)

    if screen is not None and not wait_for_screen(screen, inside):
        print("the screen never appeared", file=sys.stderr)
        compositor.terminate()
        left_behind(signature)
        return 1

    paint_the_background(inside)

    opened, was = [], surfaces(inside)
    for command in open_these:
        said = open(STAGE / ("opened-%d.log" % len(opened)), "w+")
        opened.append((command, subprocess.Popen(
            command, shell=True, env=inside, stdout=said, stderr=said), said))
    if open_these and not wait_for_something(inside, was):
        print("nothing that was asked for reached the screen", file=sys.stderr)
    if open_these:
        show_a_window(inside)
        say_what_died(opened)

    if probe:
        for question in ("monitors", "workspaces", "clients"):
            print("== %s" % question)
            print(hyprctl(inside, question, "-j")[:1200])

    if shot is not None:
        taken = subprocess.run(["grim", "-o", screen, str(shot)],
                               env=inside, capture_output=True, text=True)
        if taken.returncode == 0:
            print("%s" % shot)
            say_the_colours(shot, sample)
        else:
            print("no picture: %s" % taken.stderr.strip(), file=sys.stderr)

    if seconds:
        time.sleep(seconds)
    compositor.terminate()
    try:
        compositor.wait(timeout=10)
    except subprocess.TimeoutExpired:
        compositor.kill()
    left_behind(signature)
    return 0


def main():
    parser = argparse.ArgumentParser(prog="legion-desktop", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("stage", help="the staged copy, and nothing else")
    sub.add_parser("verify", help="does the compositor config still parse")
    running = sub.add_parser("run", help="the desktop, nested, in a window")
    running.add_argument("--seconds", type=float, default=None,
                         help="stop after this long")
    running.add_argument("--open", action="append", default=[],
                         metavar="COMMAND", help="start this inside it")
    shooting = sub.add_parser("shot", help="a picture of it")
    shooting.add_argument("file", type=Path)
    shooting.add_argument("--open", action="append", default=[],
                          metavar="COMMAND", help="start this inside it")
    shooting.add_argument("--sample", action="append", default=[],
                          metavar="X,Y",
                          help="say what colour the screen is there, in the "
                               "%dx%d the desktop is laid out in; 'most' for "
                               "whatever most of it is" % SCREEN.logical)
    shooting.add_argument("--window", action="store_true",
                          help="in a window, at the host's size, rather than "
                               "headless at the device's")
    probing = sub.add_parser("probe", help="what the nested compositor thinks")
    probing.add_argument("--open", action="append", default=[],
                         metavar="COMMAND", help="start this inside it")
    probing.add_argument("--window", action="store_true")
    sub.add_parser("clean", help="forget the staged copy")
    args = parser.parse_args()

    if args.command == "clean":
        for path in [STAGE, *abandoned(), *dead_instances()]:
            shutil.rmtree(path, ignore_errors=True)
        return 0
    if args.command != "stage":
        atexit.register(shutil.rmtree, STAGE, ignore_errors=True)
    if args.command == "stage":
        stage()
        return 0
    if args.command == "verify":
        return verify()
    if args.command == "probe":
        return run(shot=None, seconds=0.1, open_these=args.open,
                   headless=not args.window, probe=True)
    if args.command == "shot":
        return run(shot=args.file, open_these=args.open,
                   headless=not args.window, sample=args.sample)
    return run(seconds=getattr(args, "seconds", None),
               open_these=getattr(args, "open", []))


if __name__ == "__main__":
    sys.exit(main())
