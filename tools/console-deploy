#!/bin/sh
# Put this checkout on the Legion Go and bring the machine to match it.
#
#     tools/console-deploy --check    what would change, and change nothing
#     tools/console-deploy            that, then ask, then apply
#     tools/console-deploy --yes      that, without asking, and check the device
#
# The device's /etc/console is a git repository and this pushes into it, so the
# history of what the desktop is made of stays one history whether a change was
# made here or made there and saved. Everything after the push is the machine's
# own `console` doing what it always does.
set -e

if [ -z "${CONSOLE_HOST:-}" ]; then
    echo "CONSOLE_HOST is not set, so there is no device to talk to." >&2
    echo "Set it to the device, as in CONSOLE_HOST=root@handheld." >&2
    exit 1
fi
host=$CONSOLE_HOST
here=$(cd "$(dirname "$0")/.." && pwd)
cd "$here"

# One deploy at a time in this checkout.
#
# Three sessions share this working tree and none of them can see what the
# others are doing. A deploy reads the tree, decides it is still, and then
# spends minutes in `just ready` and an ssh round trip before it pushes -- and
# twice it has been beaten in that window by a file appearing from a session
# that had no way to know. What went to the device was not what was looked at.
#
# `mkdir` because it is the one filesystem operation that is atomic and tells
# you whether it was you who made it, which is what a lock is. Under `.git`
# because a lock anywhere else is a file in the working tree, and a lock that
# makes the tree dirty is a lock that fails the check it exists to protect.
#
# Held for `--check` as well as for a deploy. A check asks the device what it
# looks like, and halfway through somebody else's apply there is no answer to
# that worth reading.
lock=$here/.git/console-deploy.lock
if ! mkdir "$lock" 2>/dev/null; then
    pid=$(cat "$lock/pid" 2>/dev/null || true)
    on=$(cat "$lock/on" 2>/dev/null || true)
    since=$(cat "$lock/since" 2>/dev/null || true)
    # A lock whose process is gone was left behind by a deploy that was killed,
    # and taking it over is right. Only where this is the machine that made it:
    # a pid from somewhere else says nothing about what is running here.
    if [ -n "$pid" ] && [ "$on" = "$(hostname)" ] && ! kill -0 "$pid" 2>/dev/null; then
        echo "a deploy started $since left its lock behind; taking it over" >&2
        rm -rf "$lock"
        mkdir "$lock"
    else
        echo "somebody is already deploying this checkout." >&2
        echo "  started $since by pid $pid on $on" >&2
        echo "wait for it to finish: what it sends is decided while it runs," >&2
        echo "and a file written here meanwhile is a file it may or may not send." >&2
        exit 1
    fi
fi
# Released however this ends, including the prompts below that answer no.
trap 'rm -rf "$lock"' EXIT
trap 'rm -rf "$lock"; exit 130' INT
trap 'rm -rf "$lock"; exit 143' TERM HUP
printf '%s\n' "$$" >"$lock/pid"
hostname >"$lock/on"
date >"$lock/since"

if [ -n "$(git status --porcelain)" ]; then
    echo "there are changes here that are not committed:" >&2
    git status --short >&2
    echo "commit them first: what is deployed is what is in the history" >&2
    echo "or send the history alone, out of a clone nobody is working in:" >&2
    echo "  clone=\$(mktemp -d)/console && git clone . \"\$clone\" && cd \"\$clone\"" >&2
    echo "  CONSOLE_HOST=$host tools/console-deploy" >&2
    exit 1
fi

# What the tree was when it was looked at. Compared again below, because
# everything between here and the push takes minutes and the lock only keeps
# other deploys out -- it does not stop somebody editing a file.
was=$(git rev-parse HEAD)

echo "== everything that must hold, before anything is sent"
just ready

echo
echo "== what the device has that this does not"
git fetch --quiet "ssh://$host/etc/console" master
if [ -n "$(git log --oneline HEAD..FETCH_HEAD)" ]; then
    git log --oneline HEAD..FETCH_HEAD
    echo "pull those first: tools/console-pull" >&2
    exit 1
fi
echo "  nothing"

echo
echo "== what this has that the device does not"
git log --oneline FETCH_HEAD..HEAD || true
git diff --stat FETCH_HEAD..HEAD || true

case "$1" in
--check)
    echo
    echo "== what the machine would say about itself"
    ssh "$host" console check || true
    exit 0
    ;;
esac

if [ "$1" != "--yes" ]; then
    printf '\napply this to %s? [y/N] ' "$host"
    read -r answer
    case "$answer" in y | Y | yes) ;; *) echo "nothing sent"; exit 1 ;; esac
fi

# A push into a repository with a working tree is refused unless it is told to
# update the tree as well, and it is still refused if that tree has changes of
# its own, which is the protection worth keeping: a `console save` nobody
# committed is not overwritten from here.
#
# That protection has a sharp edge, and the fetch above is what blunts it.
# Anything that commits on the device makes a branch that has diverged, and a
# divergence does not arrive saying "somebody changed a file on the device": it
# arrives days later as a push refused for not fast-forwarding, in git's
# vocabulary rather than the machine's. So the device is asked what it has
# before anything is sent, and those commits are printed as themselves. Nothing
# on the device commits on its own -- `console apply` writes to the machine and
# not to this tree, and `console save` commits only the files it took back --
# so a commit here that nobody remembers making is worth reading before it is
# pulled.
# The tree, asked once more, because this is the last moment the answer can
# change anything. `just ready` and the fetch are minutes, and the lock keeps
# other deploys out rather than other people out: a session that wrote a file
# while this ran is exactly the fault this is here for, and the difference
# between catching it now and not is whether the device gets what was checked.
if [ -n "$(git status --porcelain)" ]; then
    echo >&2
    echo "something appeared here while this deploy was running:" >&2
    git status --short >&2
    echo "nothing sent. What was checked above is no longer what is here." >&2
    echo "commit it and start again, or send the history alone out of a clone:" >&2
    echo "  clone=\$(mktemp -d)/console && git clone . \"\$clone\" && cd \"\$clone\"" >&2
    echo "  CONSOLE_HOST=$host tools/console-deploy" >&2
    exit 1
fi
if [ "$(git rev-parse HEAD)" != "$was" ]; then
    echo >&2
    echo "the branch moved while this deploy was running:" >&2
    git log --oneline "$was..HEAD" >&2
    echo "nothing sent. Those commits were not in what \`just ready\` passed." >&2
    exit 1
fi

ssh "$host" git -C /etc/console config receive.denyCurrentBranch updateInstead
git push "ssh://$host/etc/console" HEAD:master

# The engine is built and put in place from here, before it is asked to do
# anything. It builds every other program the manifest lists, including a newer
# copy of itself, but it cannot be the thing that puts the first copy there:
# the engine on the machine is the one being replaced. Without this the device
# keeps whatever engine it was given the day it was set up, and every later
# improvement to `apply` sits in the history doing nothing.
#
# Nothing compiled is sent from here. The device has the source and the
# toolchain, so every crate the manifest lists is built there, including the
# engine above.
#
# Which is not the same as this repository holding no binaries, and the
# sentence here used to say it was. `files/usr/local/bin/hyprsession` is
# tracked, 1.8 MB of it: somebody else's GPL program, carried built, and
# `docs/rename.md` says so. It travels in the history like any other file the
# manifest names, and `console-publish` excludes it by path, so the public copy
# has never carried it.
#
# The keyboard used to be the second of those and is not any more. It is a crate
# now, in `[build]`, compiled on the device out of what this push sends like
# every other program a person touches. The C it was ported from has gone with
# the port, so there is no half of that fork left for the copy to hold back.
#
# So the rule is the one it always meant to be: what we write is built on the
# machine that runs it, and what somebody else wrote and we only forked is
# carried. Two forks left, and neither is the keyboard.
#
# The gap this comment used to describe -- the manifest not naming the toolchain
# a C build leans on -- closed by not needing one. There is no C to build on the
# device. What did have to be named is `xkeyboard-config`, which is where every
# alphabet the keyboard offers comes from now that it composes its keymap rather
# than shipping one, and it is in `[packages]`.

echo
echo "== the engine"
ssh "$host" cargo build --release --locked --manifest-path /etc/console/Cargo.toml --bin console
ssh "$host" install -m 755 /etc/console/target/release/console /usr/local/bin/console
ssh "$host" console apply

# The features, pressed on the machine that has them, now that it is the new
# one. Everything that could be asked without the device was asked before
# anything was sent -- `just ready` runs the emulated tier, which is most of
# them and costs a third of a second. What is left needs this machine: whether
# the units came up, whether the keyboard is holding the pad X arrives on, and
# whether the desktop comes back the same way twenty restarts running.
#
# At the end rather than the beginning, because until the apply has happened
# the thing being asked about is the old release. This is the only moment the
# question means what it says.
#
# Asked rather than assumed. It takes over the screen for several minutes and
# restarts the session repeatedly, which is not a thing to start under somebody
# who is holding the machine.
if [ "$1" != "--yes" ]; then
    printf '\ncheck the features on %s now? it takes the screen for a few minutes [Y/n] ' "$host"
    read -r answer
    case "$answer" in n | N | no) echo "not checked; tools/console-deploy --check asks later"; exit 0 ;; esac
fi

echo
echo "== the features, on the machine that has them"
CONSOLE_HOST=$host cargo run --quiet --bin console-check -- --stage device --yes
