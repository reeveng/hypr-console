def tracked():
    out = subprocess.run(["git", "-C", str(REPO), "ls-files"],
                         capture_output=True, text=True, check=True)
    return [line for line in out.stdout.splitlines() if line]


def scrub(text):
    text = text.replace(WAS, NOW).replace(WAS.capitalize(), NOW.capitalize())
    text = text.replace(HOST_WAS, HOST_NOW)
    return text.replace(SERIAL, "")


def publish(where):
    where = Path(where)
    if where.exists():
        shutil.rmtree(where)
    where.mkdir(parents=True)

    for name in tracked():
        if name in [f.lstrip("/") for f in FORKS] or \
                any(name.endswith(f) for f in FORKS):
            continue
        source = REPO / name
        target = where / scrub(name)
        target.parent.mkdir(parents=True, exist_ok=True)
        try:
            target.write_text(scrub(source.read_text()))
        except UnicodeDecodeError:
            shutil.copyfile(source, target)
        shutil.copymode(source, target)

    manifest = where / "desktop.conf"
    lines = [line for line in manifest.read_text().splitlines()
             if line.strip() not in FORKS]
    manifest.write_text("\n".join(lines).rstrip() + "\n" + NOT_PUBLISHED)

    (where / "docs/forks.md").write_text(FORKS_DOC)
    (where / "README.md").write_text(README)
    (where / "LICENSE").write_text(LICENCE)
    return where


def check(where):
    """Nobody's name, and the tests still pass."""
    leaked = subprocess.run(
        ["grep", "-rIl", "-e", WAS, "-e", HOST_WAS, "-e", SERIAL, str(where)],
        capture_output=True, text=True)
    if leaked.stdout.strip():
        print("still says too much:\n%s" % leaked.stdout, file=sys.stderr)
        return 1
    print("nothing of anybody's name in it")

    venv = REPO / ".venv/bin/python"
    done = subprocess.run([str(venv), "-m", "pytest", "-q",
                           "--ignore=tests/test_live.py"],
                          cwd=where, capture_output=True, text=True)
    print(done.stdout.strip().splitlines()[-1] if done.stdout else done.stderr)
    return done.returncode


def main():
    parser = argparse.ArgumentParser(prog="legion-publish", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("where", type=Path)
    args = parser.parse_args()
    where = publish(args.where)
    print("built %s" % where)
    return check(where)


if __name__ == "__main__":
    sys.exit(main())
