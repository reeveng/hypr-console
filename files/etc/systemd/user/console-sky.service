[Unit]
Description=Dynamic wallpaper
PartOf=console.target
# The wallpaper daemon has to be listening before there is any point telling it
# anything. console-paper fills the screen with a colour as it starts, which is
# the ground this then paints over: a picture chosen for the weather if there is
# one, and the colour left where it is if there is not.
Requires=console-paper.service
After=console-paper.service

[Service]
Type=simple
ExecStart=/usr/local/bin/console-sky
ExecStopPost=-/usr/local/bin/console-fell %n
Restart=always
RestartSec=5

# What this reaches past `console-.service.d/confining.conf`, and why.
#
# No device node: it chooses a picture and tells the daemon above about it. The
# home directory stays because what it chose is remembered there. This is one
# of the two units with no `RestrictAddressFamilies=`, and the reason is the
# whole feature: it asks somebody what the weather is.
PrivateDevices=yes

[Install]
WantedBy=console.target
