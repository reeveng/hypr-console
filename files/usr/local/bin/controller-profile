#!/bin/sh
# Switch the Legion Go controller between desktop and gamepad behaviour.
#   controller-profile router    every button, said as itself, for the daemon
#   controller-profile game      buttons stay a gamepad, for Steam and games
#   controller-profile keyboard  the on-screen keyboard reads the pad itself
#   controller-profile asking    a card is asking which button you just pressed
#   controller-profile           print which one is active
#
# `desktop` and `tabs` are the same file now and are kept as words for it.
# There used to be one profile for the desktop and another for while a chooser
# was up, and swapping them destroyed the pad and built a new one on every menu
# open and close. What a button means with a chooser up is the controller
# daemon's to say now, so there is one profile and nothing to swap.
#
# InputPlumber waits for udev to finish enumerating the controllers before it
# starts, so at login it is not on the bus yet. Wait for it rather than fail.
BUS=org.shadowblip.InputPlumber
OBJ=/org/shadowblip/InputPlumber/CompositeDevice0
IFACE=org.shadowblip.Input.CompositeDevice

case "$1" in
  router|desktop|tabs) P=/etc/inputplumber/profiles/router.yaml ; BUZZ=false ;;
  game)     P=/etc/inputplumber/profiles/game.yaml ; BUZZ=true ;;
  keyboard) P=/etc/inputplumber/profiles/keyboard.yaml ; BUZZ=false ;;
  # Two of the profiles in this list are not in the repository at all. Both
  # are written by `console apply` out of what this device says it can send:
  # the router, so that every button on whatever hardware this landed on
  # arrives at the daemon as itself, and the asking profile, so that while
  # somebody is being asked to press a button every press says which button it
  # was and does nothing else. A device the engine has never applied to has
  # neither file, and loading one fails here rather than silently leaving the
  # front of the machine live -- which is why these are paths like the others
  # and not special cases.
  asking)   P=/etc/inputplumber/profiles/asking.yaml ; BUZZ=false ;;
  "")      busctl --system get-property $BUS $OBJ $IFACE ProfileName 2>/dev/null | cut -d\" -f2; exit 0 ;;
  *)       echo "usage: controller-profile [router|game|keyboard|asking]" >&2; exit 2 ;;
esac

# Nothing here wakes the controller daemon any more. This used to send it
# SIGCONT on every profile load that was not the keyboard's, because the
# keyboard stopped it with SIGSTOP and a keyboard that went away without saying
# so left the daemon stopped for good: every press piled up behind it and
# arrived at once when something else woke it, which reads as buttons that need
# pressing twice.
#
# The daemon is never stopped now. It asks the compositor what is in front of
# it and stands down under the keyboard by itself, so there is nothing to undo.
# See `console_controller::mode`.

# The buzz under a thumb on the pad is the controller's, not ours: it ticks its
# own motors in firmware as a finger moves, and the host is never asked. So it
# is the one thing a profile changes that does not go through InputPlumber.
# 92-console-haptics.rules turns it off when the controller is first seen and
# hands the file over, leaving this to turn it back on for the one profile that
# might want to be felt. A machine whose driver publishes no such file is not an
# error here: there is simply nothing on it to buzz.
for buzzer in /sys/bus/hid/devices/*/touchpad/vibration_enabled; do
    [ -w "$buzzer" ] && echo "$BUZZ" > "$buzzer"
done

n=0
while [ $n -lt 60 ]; do
    if busctl --system get-property $BUS $OBJ $IFACE ProfileName >/dev/null 2>&1; then
        busctl --system call $BUS $OBJ $IFACE LoadProfilePath s "$P"
        exit $?
    fi
    n=$((n + 1))
    sleep 1
done

echo "controller-profile: InputPlumber never appeared on the bus" >&2
exit 1
