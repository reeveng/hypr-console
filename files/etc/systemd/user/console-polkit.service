[Unit]
Description=Password prompt
PartOf=console.target

[Service]
Type=simple
# polkitd asks the session a question and gives up if nothing answers. With no
# agent running, installing something is not a wrong password, it is nothing at
# all: the button does nothing and there is no way to find out why.
#
# The KDE one because Qt on this machine is already dressed in the palette by
# kdeglobals, so the box comes out in the same colours as everything else.
ExecStart=/usr/lib/polkit-kde-authentication-agent-1
ExecStopPost=-/usr/local/bin/console-fell %n
Restart=always
RestartSec=2

# What this reaches past `console-.service.d/confining.conf`, and why.
#
# No `PrivateDevices=`: the box is a Qt window and Qt draws through a render
# node. No `ProtectHome=` either, because Qt keeps its own caches there and a
# password box that stalls on a read-only cache is a permission nobody can
# give. What it may not do is leave the machine, which for a program that only
# ever asks the session a question is the whole of what it needs.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=console.target
