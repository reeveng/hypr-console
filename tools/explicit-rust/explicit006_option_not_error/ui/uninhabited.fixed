// run-rustfix
// edition:2024

enum Never {}

fn infallible(value: Result<String, Never>) -> Option<String> {
    match value { ::core::result::Result::Ok(_result_value) => ::core::option::Option::Some(_result_value), ::core::result::Result::Err(_impossible_variant) => match _impossible_variant {} }
}

fn impossible_success(value: Result<core::convert::Infallible, String>) -> Option<String> {
    match value { ::core::result::Result::Err(_result_value) => ::core::option::Option::Some(_result_value), ::core::result::Result::Ok(_impossible_variant) => match _impossible_variant {} }
}

fn followed_by_a_method(value: Result<u32, Never>) -> bool {
    (match value { ::core::result::Result::Ok(_result_value) => ::core::option::Option::Some(_result_value), ::core::result::Result::Err(_impossible_variant) => match _impossible_variant {} }).is_some()
}

fn main() {
    assert_eq!(infallible(Ok(String::from("value"))).as_deref(), Some("value"));
    assert_eq!(impossible_success(Err(String::from("fault"))).as_deref(), Some("fault"));
    assert!(followed_by_a_method(Ok(4)));
}
