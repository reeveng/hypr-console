# ------------------------------------------------------------------ resolving

class Short(Exception):
    """A pairing that does not clear what it was asked to clear."""


def resolve(declared):
    """Every colour as six hex digits, in an order that respects what each needs.

    A colour whose floor is expressed against another colour cannot be worked
    out until that other one is. Nothing here declares a cycle, so passing over
    the list until it stops growing is enough, and a pass that adds nothing
    means somebody wrote one.
    """
    done, pending = {}, dict(declared)
    while pending:
        progressed = False
        for name, spec in list(pending.items()):
            least = spec.get("least", {})
            needed = set(least.get("on", [])) | set(least.get("carries", []))
            if not needed <= done.keys():
                continue
            done[name] = solve(spec, done)
            del pending[name]
            progressed = True
        if not progressed:
            raise Short(f"these colours wait on each other: {sorted(pending)}")
    return done


def solve(spec, known):
    """One colour: where it wants to sit, lifted to where it has to sit."""
    hue, chroma = spec["hue"], spec["chroma"]
    lightness = spec.get("lightness", 0.0)
    least = spec.get("least", {})
    grounds = [known[name] for name in least.get("on", [])]
    if grounds:
        lightness = max(lightness, col.lightest_clearing(
            chroma, hue, grounds, least["ratio"], floor=0.0))
    for name in least.get("carries", []):
        # Something dark is painted on top of this one, so this one has to be
        # light enough for it. The ink is already fixed, so the fill gives way.
        ink = known[name]
        while col.contrast(col.hexcode(lightness, chroma, hue), ink) < least["carries_ratio"]:
            lightness += 0.002
            if lightness > 1.0:
                raise Short(f"no shade at hue {hue} carries #{ink}")
    return col.hexcode(lightness, chroma, hue)


def lift(code, amount):
    """A colour moved towards white by `amount`, keeping its hue.

    What a terminal means by bright: the same colour with more light in it.
    Mixing towards white instead would take the colour out as well.
    """
    lightness, chroma, hue = to_oklch(code)
    return col.hexcode(min(1.0, lightness + amount), chroma, hue)


def to_oklch(code):
    """Back the other way, which is the same matrices in the other order."""
    code = code.lstrip("#")
    channels = [int(code[i:i + 2], 16) / 255 for i in (0, 2, 4)]
    red, green, blue = (col._to_linear(channel) for channel in channels)
    long, medium, short = (
        (0.4122214708 * red + 0.5363325363 * green + 0.0514459929 * blue) ** (1 / 3),
        (0.2119034982 * red + 0.6806995451 * green + 0.1073969566 * blue) ** (1 / 3),
        (0.0883024619 * red + 0.2817188376 * green + 0.6299787005 * blue) ** (1 / 3),
    )
    lightness = 0.2104542553 * long + 0.7936177850 * medium - 0.0040720468 * short
    a = 1.9779984951 * long - 2.4285922050 * medium + 0.4505937099 * short
    b = 0.0259040371 * long + 0.7827717662 * medium - 0.8086757660 * short
    return lightness, math.hypot(a, b), math.degrees(math.atan2(b, a)) % 360


# ------------------------------------------------------------------- checking

def measure(spec, palette):
    """Every declared pairing with the ratio it actually reached."""
    rows = []
    for pair in spec.get("pair", []):
        fronts = pair["front"]
        for front in ([fronts] if isinstance(fronts, str) else fronts):
            for back in pair["back"]:
                got = col.contrast(palette[front], palette[back])
                rows.append((front, back, pair["ratio"], got,
                             pair.get("kind", "text"), pair["where"]))
    return rows


def grade(ratio, kind="text"):
    """What a ratio is worth, for what the pairing is for.

    A grade is about text, so only text is graded. A border has a floor of 3:1
    and clearing it is the whole of what is asked; a bar against the wallpaper
    behind it only has to be seen as a different thing. Reporting those two as
    failed AA would be reporting a fact about the wrong question.
    """
    if kind == "edge":
        return "clears the 3:1 a border needs" if ratio >= 3.0 else "under"
    if kind == "seen":
        return "a visible step" if ratio >= 1.05 else "flat"
    if kind == "quiet":
        return "AA, on purpose" if ratio >= 4.5 else "under"
    if ratio >= 7.0:
        return "AAA"
    if ratio >= 4.5:
        return "AA"
    return "under"


