[Unit]
Description=Desktop events
PartOf=console.target
# It comes after nothing and nothing comes after it. Every program that asks it
# for something reconnects for as long as it wants an answer, so a pool that is
# not up yet is a pool that is asked again in a second -- which is the same
# thing that has to be true anyway, because this restarts and the programs
# listening to it do not.

[Service]
Type=simple
ExecStart=/usr/local/bin/console-events
ExecStopPost=-/usr/local/bin/console-fell %n
Restart=always
RestartSec=5

# What this reaches past `console-.service.d/confining.conf`, and why.
#
# It opens no device. What it holds is one subscription per source and one
# socket of its own, all of them under the runtime directory -- and where a
# source is somebody else's program rather than a socket, it is that program's
# output being read. `pactl subscribe` is the first of those and it was watched
# under exactly these lines before it was believed: `pactl` reaches the sound
# server over a socket in the runtime directory and never opens `/dev/snd`, so
# `PrivateDevices=` costs it nothing. The home directory is read-only rather
# than gone because a watched path is a topic this will grow and most of the
# paths anybody would watch are in it; nothing here writes there, and the day
# something does, this line is where the argument goes.
#
# The three that came after it were watched the same way and pass for the same
# reason. `nmcli monitor` asks NetworkManager over the system bus and prints
# what it hears; `busctl --user monitor` reaches the session bus. Both are a
# socket on this machine and neither wants a device. The one thing worth
# writing down about busctl is that its `Monitoring bus message stream.` goes
# to standard error, which a source sends nowhere, so getting in is not
# mistaken for something having happened.
#
# `AF_UNIX` alone. Every source it holds is a socket on this machine or a
# program that reaches one, and the one thing that would ever take it off the
# machine is a mistake.
PrivateDevices=yes
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=console.target
