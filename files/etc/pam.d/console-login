#%PAM-1.0
# What a person's session is opened by, whether they drew the pattern or it
# was the first login of the boot. The pattern is not the account's password
# and is checked by the login window against its own hash, so this stack is
# asked for the account and the session and never to authenticate.
auth       include      system-local-login
account    include      system-local-login
password   include      system-local-login
session    include      system-local-login
