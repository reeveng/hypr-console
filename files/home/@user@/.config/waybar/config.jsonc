// Two bars, drawn in this order. waybar reserves the room for each in turn,
// so the strip below is under the bar and not over it.
[

{
  // Top, because the on-screen keyboard owns the bottom of the screen.
  "layer": "top",
  "position": "top",
  "height": 38,
  // Nothing between the modules. What separates them is the slab each one
  // wears -- its padding, which is also the area that answers a tap -- and
  // the 2px margin that keeps two lit slabs from touching. waybar's spacing
  // is on top of both and is neither: ten pixels of bar that highlight
  // nothing, open nothing, and push every icon further from the last. The
  // gap between two targets was fourteen pixels for four pixels of reason.
  "spacing": 0,

  "modules-left": ["custom/apps", "custom/keyboard", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/music",
    "custom/sound",
    "custom/bluetooth",
    "custom/network",
    "custom/battery",
    "custom/notices",
    "tray"
  ],

  // The two doors a finger has no other way through. Everything else along
  // here is a reading that happens to open something when it is tapped; these
  // two are buttons and nothing else, and they are on the left because that is
  // where the thumb of the hand not holding the device falls.
  //
  // Both toggle. Tapped again they put away what they brought out, which is
  // the whole of how a menu or a keyboard is closed without a controller.
  //
  // Which is why both are lit while what they opened is on the screen, the
  // same way the workspace you are on is lit. A control that opens and closes
  // the same thing has to say which it is about to do, and these two said
  // nothing: the icon looked identical with the menu up and with it gone.
  //
  // `bar-door` runs for as long as the bar does and prints a line whenever the
  // answer changes, which it learns from the compositor rather than from
  // anything written down. restart-interval is the net under it: a compositor
  // that was not up yet leaves it nothing to listen to, and it exits.
  "custom/apps": {
    "format": "{}",
    "return-type": "json",
    "exec": "bar-door launcher 󰀻",
    "restart-interval": 5,
    "tooltip": false,
    "on-click": "launcher"
  },

  "custom/keyboard": {
    "format": "{}",
    "return-type": "json",
    "exec": "bar-door keyboard 󰌌",
    "restart-interval": 5,
    "tooltip": false,
    "on-click": "keyboard-toggle"
  },

  // No on-click. "activate" is sway's word for it, and waybar hands a
  // hyprland/workspaces on-click to a shell like any other: the journal has
  // `sh: line 1: activate: command not found` for every workspace anybody
  // tapped. Left alone, the module switches to the workspace itself, which
  // is what the line was asking for.
  "hyprland/workspaces": {
    "format": "{id}"
  },

  // One reading, always the same one. A handheld is picked up cold and put
  // down again; a clock that changes what it says when a thumb brushes it is
  // a clock that has to be read twice.
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip": false
  },

  // The four readings along the right, each of which opens its own tab of the
  // settings. They are ours rather than waybar's own modules for one reason:
  // waybar's cannot be given a class from outside, so the icon could not say
  // that the tab it opens is already on the screen. `bar-say` reads the same
  // machine and lights the icon while its tab is in front.
  "custom/sound": {
    "format": "{}",
    "return-type": "json",
    "exec": "bar-say sound",
    "restart-interval": 5,
    "tooltip": false,
    // Tap opens the mixer; a second tap on the icon itself mutes.
    "on-click": "settings-panel Sound",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "custom/bluetooth": {
    "format": "{}",
    "return-type": "json",
    "exec": "bar-say bluetooth",
    "restart-interval": 5,
    "tooltip": false,
    "on-click": "settings-panel Bluetooth"
  },

  "custom/network": {
    "format": "{}",
    "return-type": "json",
    "exec": "bar-say network",
    "restart-interval": 5,
    "tooltip": false,
    "on-click": "settings-panel Wi-Fi"
  },

  "custom/battery": {
    "format": "{}",
    "return-type": "json",
    "exec": "bar-say battery",
    "restart-interval": 5,
    "tooltip": false,
    "on-click": "settings-panel Battery"
  },

  // The music, beside the sound it comes out of. Not waybar's mpris module,
  // which draws nothing at all while no player is running.
  //
  // Lit while the panel is up, as the two doors on the left are: it opens and
  // closes the same thing, so it has to say which a tap will do.
  "custom/music": {
    "format": "{}",
    "return-type": "json",
    "exec": "music-bar 󰝚",
    "restart-interval": 5,
    "max-length": 24,
    "tooltip": false,
    "on-click": "music-panel"
  },

  // What the desktop said and nobody has cleared. mako holds a notification
  // until it runs out of seconds or a thumb takes it down, and this counts
  // what it is holding.
  //
  // Which is nearly always a fault: everything else here raises a notification
  // that takes itself down after five seconds, and console-say raises the one
  // kind that waits. So the bell is lit when something went wrong and is still
  // wrong.
  //
  // It is beside the tray rather than among the readings because it is not a
  // reading. The five to its left say what the machine is doing and are never
  // silent; this one is empty nearly all the time, which is the whole of what
  // makes it worth looking at.
  //
  // A tap opens the panel, the way every other icon along this edge opens one,
  // and a second tap puts it away. It used to clear the lot instead, which was
  // the only thing a finger could do to a notification and threw away the one
  // thing worth having: a card is 320 by 140 and the line that says which
  // service fell is the part that did not fit on it. The panel is where that
  // line is, and clearing them all is a row on it.
  "custom/notices": {
    "format": "{}",
    "return-type": "json",
    "exec": "bar-notice",
    "restart-interval": 5,
    "tooltip": false,
    "on-click": "notices-panel"
  },

  "tray": { "spacing": 10 }
},

// The strip: a thin row under the bar, the width of the screen.
//
// Its whole job is to answer "how much longer" during an apply. The card
// `console-updating` raises says one is running and then says the same
// sentence for a minute; this fills from the left as the apply goes, which is
// the question somebody standing over the device is actually asking, answered
// from across a room without covering anything.
//
// It is the colour of the bar the rest of the time -- `bar-updating` sends an
// empty text, waybar hides the module, and what is left is this window's own
// background, which is the bar's. So it reads as the bottom edge of the bar
// until there is something to say.
//
// Which is what it costs: a row of screen, always, for a strip that is doing
// something for a minute or two after a deploy. It is bought rather than
// taken -- an overlay that did not reserve it would sit on top of the bar
// above instead of under it, and one that appeared only during an apply would
// shove every window on the screen down and back. So `height` is as thin as a
// row can be and still be a row.
//
// It only holds if the stylesheet agrees. `height` is a floor rather than a
// size and the module's label holds a space, so a label left at a font size
// grows the strip to a line of text as soon as it has a background to draw.
// `font-size: 0` there is what leaves this the deciding number.
//
// `interval: once` with a `signal` rather than a number of seconds. The engine
// knows when the number changed and says so; a second-by-second read of a file
// that is not there for days at a time is a wake-up a battery pays for with
// nothing to show. The signal has to be the one `going::WAKING` sends, and
// `the_bar_and_the_engine_agree_on_the_signal` is what holds the two numbers
// together.
{
  "name": "updating",
  "layer": "top",
  "position": "top",
  "height": 2,
  "spacing": 0,

  "modules-center": ["custom/updating"],

  "custom/updating": {
    "format": "{}",
    "return-type": "json",
    "exec": "bar-updating",
    "interval": "once",
    "signal": 4,
    "tooltip": false
  }
}

]
