// run-rustfix
// edition:2024

fn read(trace: &mut Vec<u8>, result: Option<Option<u8>>) -> Option<Option<u8>> {
    trace.push(1);
    result
}

fn evaluate(enabled: bool, trace: &mut Vec<u8>, result: Option<Option<u8>>) -> Option<u8> {
    if enabled && let Some(score) = { let checked_value = read(trace, result)?; checked_value } {
        trace.push(2);
        return Some(score);
    }
    trace.push(3);
    Some(0)
}

fn main() {
    let mut trace = Vec::new();
    assert_eq!(evaluate(false, &mut trace, None), Some(0));
    assert_eq!(trace, [3]);
    trace.clear();
    assert_eq!(evaluate(true, &mut trace, None), None);
    assert_eq!(trace, [1]);
    trace.clear();
    assert_eq!(evaluate(true, &mut trace, Some(None)), Some(0));
    assert_eq!(trace, [1, 3]);
    trace.clear();
    assert_eq!(evaluate(true, &mut trace, Some(Some(5))), Some(5));
    assert_eq!(trace, [1, 2]);
}
