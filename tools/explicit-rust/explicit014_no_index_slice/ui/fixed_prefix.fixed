// run-rustfix
// edition:2024

fn read(bytes: [u8; 8]) -> (u8, u8) {
    (match bytes { [_, _, _, _, _, _explicit_element, ..] => _explicit_element }, match bytes { [_, _, _, _, _, _, _explicit_element, ..] => _explicit_element })
}

fn tail(bytes: &[u8; 8]) -> u8 {
    match bytes { &[_, _, _, _, _explicit_element, ..] => _explicit_element }
}

fn borrow_mut(bytes: &mut [String; 3]) -> &mut String {
    { let [_, _explicit_part, ..] = &mut *bytes; _explicit_part }
}

fn assign(words: &mut [String; 3], replacement: fn(&[String; 3]) -> String) {
    *{ let [_explicit_part, ..] = &mut *words; _explicit_part } = replacement(words);
}

fn suffix<'a>(bytes: &&'a [u8; 8]) -> &'a [u8] {
    { let [_, _, _, _, _, _, _explicit_part @ ..] = &**bytes; let _explicit_slice: &[_] = _explicit_part; _explicit_slice }
}

fn suffix_mut(bytes: &mut [u8; 8]) -> &mut [u8] {
    { let [_, _, _, _, _, _, _, _explicit_part @ ..] = &mut *bytes; let _explicit_slice: &mut [_] = _explicit_part; _explicit_slice }
}

fn whole(bytes: &[u8; 8]) -> &[u8] {
    { let _explicit_part = &*bytes; let _explicit_slice: &[_] = _explicit_part; _explicit_slice }
}

fn empty(bytes: &[u8; 8]) -> &[u8] {
    { let [_, _, _, _, _, _, _, _, _explicit_part @ ..] = &*bytes; let _explicit_slice: &[_] = _explicit_part; _explicit_slice }
}

fn nested(mut grid: [[u8; 4]; 2]) -> (u8, u8) {
    *{ let [_, [_, _, _explicit_part, ..], ..] = &mut grid; _explicit_part } += match grid { [[_, _explicit_element, ..], ..] => _explicit_element };
    let [_, [_, _, updated, ..], ..] = grid;
    (updated, match grid { [_, [_, _, _, _explicit_element, ..], ..] => _explicit_element })
}

fn row(grid: &[[u8; 4]; 2]) -> [u8; 4] {
    match grid { &[_, _explicit_element, ..] => _explicit_element }
}

fn main() {
    let mut bytes = [0, 1, 2, 3, 4, 5, 6, 7];
    assert_eq!(read(bytes), (5, 6));
    assert_eq!(tail(&bytes), 4);
    assert_eq!(suffix(&&bytes), &[6, 7]);
    assert_eq!(whole(&bytes), &bytes);
    assert!(empty(&bytes).is_empty());
    suffix_mut(&mut bytes).fill(8);
    assert_eq!(suffix(&&bytes), &[6, 8]);
    let mut words = [String::from("one"), String::from("two"), String::from("three")];
    borrow_mut(&mut words).push('!');
    assert!(words.contains(&String::from("two!")));
    assign(&mut words, |values| values.concat());
    assert!(words.contains(&String::from("onetwo!three")));
    assert_eq!(nested([[1, 2, 3, 4], [5, 6, 7, 8]]), (9, 8));
    assert_eq!(row(&[[1, 2, 3, 4], [5, 6, 7, 8]]), [5, 6, 7, 8]);
}
