# Let the session change the screen brightness.
#
# The backlight is owned by root and readable by everyone, so a brightness
# button pressed by the person using the machine could not act on it. This
# hands the file to the video group, which that account is already in.
ACTION=="add", SUBSYSTEM=="backlight", \
  RUN+="/usr/bin/chgrp video /sys/class/backlight/%k/brightness", \
  RUN+="/usr/bin/chmod g+w /sys/class/backlight/%k/brightness"
