#!/bin/sh
# Screen brightness, in steps, within the range this panel can actually show.
#
# The panel takes a number up to 65535, but anything near the top of that range
# comes back out as nothing: setting it to full turns the backlight off. 64000
# is the highest value that still lights the screen, so that is the ceiling
# here. The floor is well above zero for the same reason in reverse: a screen
# nobody can read is not a brightness setting.
# `get` is the same range read the other way round, in points of a hundred, so
# that the panel can draw a bar of it. Nothing else may work out what full is:
# a second opinion about this screen is two numbers that part company the day
# either of them moves.
DEVICE=/sys/class/backlight/amdgpu_bl1
CEILING=64000
FLOOR=3200
STEP=6000

current=$(cat "$DEVICE/brightness")

case "$1" in
up)   next=$((current + STEP)) ;;
down) next=$((current - STEP)) ;;
get)
    level=$(( (current - FLOOR) * 100 / (CEILING - FLOOR) ))
    [ "$level" -lt 0 ] && level=0
    [ "$level" -gt 100 ] && level=100
    echo "$level"
    exit 0
    ;;
*)    echo "usage: console-brightness [up|down|get]" >&2; exit 2 ;;
esac

[ "$next" -gt "$CEILING" ] && next=$CEILING
[ "$next" -lt "$FLOOR" ] && next=$FLOOR

echo "$next" > "$DEVICE/brightness"
