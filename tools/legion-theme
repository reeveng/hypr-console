def gtk_palette(palette):
    """The palette in GTK's stylesheet language, which is imported by five files.

    waybar, wofi, the panel, GTK's own themes and libadwaita all read GTK CSS
    and all support @import, so this is the only file among them that holds a
    hex. The names libadwaita and Breeze ask for are defined here too, as
    references rather than as colours, so that a role changing its shade
    changes every name that stands for it.
    """
    width = max(len(name) for name in ROLES)
    lines = ["/* Written by tools/legion-theme from theme/palette.toml.",
             "   Everything on this machine that speaks GTK's stylesheet language",
             "   imports this file. Nothing else among them holds a colour. */", ""]
    lines += [f"@define-color {name:<{width}} #{palette[name]};" for name in ROLES]
    lines += ["", "/* The names libadwaita reads, as references: a role changing its",
              "   shade changes every name that stands for it. */"]
    for name, role in ADWAITA:
        lines.append(f"@define-color {name:<28} @{role};")
    lines += ["", "/* The names Breeze GTK reads, which are not libadwaita's and are many.",
              "   Left alone this list is written by Plasma's settings, which this",
              "   machine does not run, so it sat a whole flavour behind the screen. */"]
    width = max(len(name) for name in BREEZE) + len("_breeze")
    for name in sorted(BREEZE):
        lines.append(f"@define-color {name + '_breeze':<{width}} @{breeze_role(name)};")
    return "\n".join(lines) + "\n"


def firefox_palette(palette):
    """The same, as custom properties, which is the only kind Firefox's chrome takes."""
    width = max(len(name) for name in ROLES)
    body = "\n".join(f"  --{name:<{width}}: #{palette[name]};" for name in ROLES)
    return ("/* Written by tools/legion-theme from theme/palette.toml.\n"
            "   userChrome.css and userContent.css both import this and neither\n"
            "   holds a colour of its own. */\n\n:root {\n" + body + "\n}\n")


def terminal_palette(palette, spec):
    """The terminal's colours as a file alacritty imports.

    TOML has no way to name a colour once and use it twice, so the sixteen are
    spelled out. They are spelled out here and nowhere else, and alacritty.toml
    names this file rather than repeating them.
    """
    term = terminal_set(spec, palette)
    order = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    lines = ["# Written by tools/legion-theme from theme/palette.toml.",
             "# Imported by alacritty.toml, which holds no colour of its own.",
             "",
             "[colors.primary]",
             f'background = "0x{term["background"]}"',
             f'foreground = "0x{term["foreground"]}"',
             "",
             "[colors.cursor]",
             f'cursor = "0x{term["cursor"]}"',
             f'text = "0x{term["background"]}"',
             "",
             "[colors.selection]",
             f'background = "0x{term["selection"]}"',
             f'text = "0x{term["background"]}"']
    for shade in ("normal", "bright"):
        lines += ["", f"[colors.{shade}]"]
        lines += [f'{slot} = "0x{term[shade][slot]}"' for slot in order]
    return "\n".join(lines) + "\n"


def shell_palette(palette):
    """The palette as shell variables, for the keyboard.

    wvkbd takes its colours as arguments and has no configuration file, so
    something has to turn them into a command line. osk-start sources this and
    spends them by name.

    Not aligned on the equals sign the way the stylesheet is aligned: a space
    before it makes the shell read the name as a command, and a palette that
    lines up beautifully and stops the keyboard starting is not a trade
    anybody wants.
    """
    body = "\n".join(f"{name}={palette[name]}" for name in ROLES)
    return ("# Written by tools/legion-theme from theme/palette.toml.\n"
            "# Sourced by osk-start, which holds no colour of its own.\n\n"
            + body + "\n")


def region(path, body):
    """Replace what sits between the two markers, leaving the rest alone.

    For the two files that cannot import anything. The rest of such a file has
    a shape and an owner, and only the colours are written here.
    """
    lines = path.read_text().splitlines(keepends=True)
    starts = [i for i, line in enumerate(lines) if BEGIN in line]
    ends = [i for i, line in enumerate(lines) if END in line]
    if len(starts) != 1 or len(ends) != 1 or ends[0] < starts[0]:
        raise Short(f"{path} has no single {BEGIN}..{END} to write into")
    return "".join(lines[:starts[0] + 1]) + body.rstrip("\n") + "\n" + "".join(lines[ends[0]:])


def terminal_set(spec, palette):
    """The sixteen a program may ask for by number, and what surrounds them."""
    setting = spec["terminal"]
    normal = {slot: palette[name] for slot, name in setting["normal"].items()}
    bright = {slot: lift(code, setting["bright_lift"]) for slot, code in normal.items()}
    bright["white"] = palette["text"]
    return {
        "background": palette[setting["background"]],
        "foreground": palette[setting["foreground"]],
        "cursor": palette[setting["cursor"]],
        "selection": palette[setting["selection"]],
        "normal": normal,
        "bright": bright,
    }


def rgb(code):
    """A colour as the three decimal numbers a KDE config file wants."""
    code = code.lstrip("#")
    return ",".join(str(int(code[i:i + 2], 16)) for i in (0, 2, 4))


def hyprland_block(palette):
    """The compositor's two borders, and the colour behind everything.

    `background_color` is what the screen is where no window and no wallpaper
    covers it. Hyprland's own default is a neutral grey, which is close enough
    to a background that a wallpaper daemon can stop working without anybody
    going to look for it. Told the palette instead, the desktop is the right
    colour even with nothing painting on it.
    """
    return "\n".join([
        "local blossom = {",
        f'    active   = "rgba({palette["pink"]}ff)",',
        f'    inactive = "rgba({palette["edge"]}ff)",',
        f'    behind   = "rgba({palette["night"]}ff)",',
        "}",
    ])


def kdeglobals_block(palette):
    """Qt's colours.

    Qt applications ask for a role rather than a colour, and Fusion answers out
    of this file, so a file manager and a print dialogue arrive already wearing
    the palette without a widget theme being installed to do it.
    """
    common = [
        f"DecorationFocus={rgb(palette['pink'])}",
        f"DecorationHover={rgb(palette['pink'])}",
        f"ForegroundActive={rgb(palette['peach'])}",
        f"ForegroundInactive={rgb(palette['soft'])}",
        f"ForegroundLink={rgb(palette['sky'])}",
        f"ForegroundNegative={rgb(palette['coral'])}",
        f"ForegroundNeutral={rgb(palette['butter'])}",
        f"ForegroundNormal={rgb(palette['text'])}",
        f"ForegroundPositive={rgb(palette['leaf'])}",
        f"ForegroundVisited={rgb(palette['mauve'])}",
    ]
    sections = {
        "Colors:Button": (palette["panel"], palette["ground"]),
        "Colors:Complementary": (palette["ground"], palette["night"]),
        "Colors:Header": (palette["ground"], palette["night"]),
        "Colors:Tooltip": (palette["panel"], palette["ground"]),
        "Colors:View": (palette["night"], palette["ground"]),
        "Colors:Window": (palette["ground"], palette["night"]),
    }
    lines = []
    for name, (normal, alternate) in sections.items():
        lines += [f"[{name}]",
                  f"BackgroundAlternate={rgb(alternate)}",
                  f"BackgroundNormal={rgb(normal)}", *common, ""]
    lines += ["[Colors:Selection]",
              f"BackgroundAlternate={rgb(palette['pink'])}",
              f"BackgroundNormal={rgb(palette['pink'])}",
              f"DecorationFocus={rgb(palette['pink'])}",
              f"DecorationHover={rgb(palette['pink'])}",
              # On a pink fill every one of these is the dark ink, because the
              # fill is the thing carrying contrast and a second hue on top of
              # it would be the one unreadable place in the palette.
              *[f"{role}={rgb(palette['night'])}" for role in
                ("ForegroundActive", "ForegroundInactive", "ForegroundLink",
                 "ForegroundNegative", "ForegroundNeutral", "ForegroundNormal",
                 "ForegroundPositive", "ForegroundVisited")],
              ""]
    lines += ["[WM]",
              f"activeBackground={rgb(palette['panel'])}",
              f"activeBlend={rgb(palette['pink'])}",
              f"activeForeground={rgb(palette['text'])}",
              f"inactiveBackground={rgb(palette['ground'])}",
              f"inactiveBlend={rgb(palette['soft'])}",
              f"inactiveForeground={rgb(palette['soft'])}"]
    return "\n".join(lines)


def firefox_prefs_block(palette):
    """The colours Firefox will not take from a stylesheet.

    A page that has not painted yet is painted by the browser, and left alone
    that is white: on a dark desktop every link opens with a flash bright
    enough to be the brightest thing that happens all day.
    """
    return "\n".join([
        f'user_pref("browser.display.background_color", "#{palette["night"]}");',
        f'user_pref("browser.display.background_color.dark", "#{palette["night"]}");',
        f'user_pref("browser.display.foreground_color", "#{palette["text"]}");',
        f'user_pref("browser.anchor_color", "#{palette["sky"]}");',
        f'user_pref("browser.visited_color", "#{palette["mauve"]}");',
        f'user_pref("browser.active_color", "#{palette["pink"]}");',
    ])


# ------------------------------------------------------------------- the picture

WALLPAPER = (800, 1280)

# An ordered dither. A gradient this dark crosses very few 8-bit values over
# the whole screen, and without a little noise thrown in first the steps
# between them appear as bands you cannot stop seeing once you have.
BAYER = [[0, 32, 8, 40, 2, 34, 10, 42], [48, 16, 56, 24, 50, 18, 58, 26],
         [12, 44, 4, 36, 14, 46, 6, 38], [60, 28, 52, 20, 62, 30, 54, 22],
         [3, 35, 11, 43, 1, 33, 9, 41], [51, 19, 59, 27, 49, 17, 57, 25],
         [15, 47, 7, 39, 13, 45, 5, 37], [63, 31, 55, 23, 61, 29, 53, 21]]


def ramp(spec, steps=512):
    """The gradient the picture is made of, worked out once.

    From the deepest ground to a shade a little above the bar, with the pink
    growing as it lightens. Computing this per pixel would be a million cube
    roots for a picture that only ever holds a few hundred distinct colours.
    """
    hue = spec["meta"]["neutral_hue"]
    out = []
    for step in range(steps):
        share = step / (steps - 1)
        lightness = 0.185 + 0.235 * share ** 1.15
        chroma = 0.020 + 0.062 * share ** 1.5
        drift = hue + 18 * share
        out.append([min(1.0, max(0.0, channel)) * 255
                    for channel in col.oklch_to_rgb(lightness, col.fit(lightness, chroma, drift), drift)])
    return out


def bloom(width, height):
    """How much light reaches each pixel, as a field between 0 and 1.

    Light off the top left corner, a softer second source low and right so the
    corner opposite is not dead, and a scatter of soft rounds too faint to be
    looked at directly. The screen is held in two hands and the middle of it is
    where a window goes, so the picture keeps its interest at the edges.
    """
    rounds = []
    seed = 20260828
    for _ in range(14):
        seed = (seed * 1103515245 + 12345) % (1 << 31)
        x = (seed >> 8) % width
        seed = (seed * 1103515245 + 12345) % (1 << 31)
        y = (seed >> 8) % height
        seed = (seed * 1103515245 + 12345) % (1 << 31)
        radius = 40 + (seed >> 8) % 130
        rounds.append((x, y, radius * radius))

    far = (width ** 2 + height ** 2) ** 0.5
    field = []
    for y in range(height):
        row = []
        for x in range(width):
            near = 1.0 - ((x * x + y * y) ** 0.5) / far
            low = 1.0 - (((width - x) ** 2 + (height - y) ** 2) ** 0.5) / far
            row.append(0.78 * near ** 1.25 + 0.34 * low ** 2.6)
        field.append(row)

    # Each round reaches only as far as it reaches, so only that square of the
    # picture is walked. Asking every round about every pixel instead is
    # fourteen questions a pixel, and the picture is a million pixels.
    for cx, cy, area in rounds:
        radius = int(area ** 0.5)
        for y in range(max(0, cy - radius), min(height, cy + radius + 1)):
            row = field[y]
            for x in range(max(0, cx - radius), min(width, cx + radius + 1)):
                gap = (x - cx) ** 2 + (y - cy) ** 2
                if gap < area:
                    row[x] += 0.055 * (1 - gap / area) ** 2

    return [[min(1.0, max(0.0, value)) for value in row] for row in field]


def picture(spec):
    """The wallpaper, as the bytes of a PNG."""
    width, height = WALLPAPER
    shades, field = ramp(spec), bloom(width, height)
    steps = len(shades) - 1
    rows = bytearray()
    for y in range(height):
        rows.append(0)
        line = field[y]
        for x in range(width):
            noise = (BAYER[y & 7][x & 7] - 31.5) / 64
            for channel in range(3):
                value = shades[round(line[x] * steps)][channel] + noise
                rows.append(min(255, max(0, round(value))))
    return png(width, height, bytes(rows))


def png(width, height, rows):
    def chunk(kind, payload):
        body = kind + payload
        return struct.pack(">I", len(payload)) + body + struct.pack(">I", zlib.crc32(body))

    header = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    return (b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", header)
            + chunk(b"IDAT", zlib.compress(rows, 9))
            + chunk(b"IEND", b""))


