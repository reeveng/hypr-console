// run-rustfix
// edition:2024

#![allow(dead_code, non_camel_case_types, unused_braces)]

use std::cell::Cell;

enum Command {
    Move(u8, u8),
    Close,
    Draw { length: u8 },
    r#move,
}

impl Command {
    fn destination(&self) -> u8 {
        match self {
            Self::Move(x, y) => { x + y },
            Self::Close | Self::Draw { .. } | Self::r#move => { 0 },
        }
    }
}

fn payload(input: Result<Option<u8>, ()>) -> u8 {
    match input {
        Ok(Some(value)) => { value },
        ::core::result::Result::Err(_) | ::core::result::Result::Ok(::core::option::Option::None) => { 0 },
    }
}

fn pair(left: &Option<u8>, right: &Option<u8>) -> u8 {
    match (left, right) {
        (Some(x), Some(y)) => { x + y },
        (::core::option::Option::None, _) | (_, ::core::option::Option::None) => { 0 },
    }
}

struct Table(Option<u8>);

impl Table {
    fn read(&self) -> Result<u8, ()> {
        self.0.ok_or(())
    }
}

fn table(first: &Table, second: &Table) -> u8 {
    match first.read() {
        Ok(value) => {
            value
        },
        ::core::result::Result::Err(_) => match second.read() {
            Ok(value) => {
                value
            },
            ::core::result::Result::Err(_) => {
                0
            },
        },
    }
}

const fn marker(count: u8) -> &'static str {
    match count {
        0 => "empty",
        _ => { "text" },
    }
}

fn has_neighbors(items: &[u8]) -> &'static str {
    match items {
        [_, ..] => "neighbors",
        [] => "isolated",
    }
}

fn ordered_arms() {
    let mut lhs = 4;
    let result = match ::core::cmp::Ord::cmp(&::core::convert::identity(lhs), &::core::convert::identity({ lhs = 11; 9 })) {
        ::core::cmp::Ordering::Equal | ::core::cmp::Ordering::Greater => lhs,
        ::core::cmp::Ordering::Less => 0,
    };
    assert_eq!(result, 0);
    assert_eq!(lhs, 11);
}

struct Observe<'a>(&'a Cell<u8>);

impl Drop for Observe<'_> {
    fn drop(&mut self) {
        self.0.set(self.0.get() + 1);
    }
}

impl Observe<'_> {
    fn length(&self) -> u8 { 3 }
}

fn drop_scopes() {
    let drops = Cell::new(0);
    match { let _explicit_ordering = ::core::cmp::Ord::cmp(&::core::convert::identity(Observe(&drops).length()), &::core::convert::identity(1)); _explicit_ordering } {
        ::core::cmp::Ordering::Greater => {
            assert_eq!(drops.get(), 1);
        },
        ::core::cmp::Ordering::Less | ::core::cmp::Ordering::Equal => {},
    }
    match ::core::cmp::Ord::cmp(&::core::convert::identity(Observe(&drops).length()), &::core::convert::identity(1)) {
        ::core::cmp::Ordering::Greater => assert_eq!(drops.get(), 1),
        ::core::cmp::Ordering::Less | ::core::cmp::Ordering::Equal => unreachable!(),
    }
    match { let _explicit_ordering = ::core::cmp::Ord::cmp(&::core::convert::identity(Observe(&drops).length()), &::core::convert::identity(1)); _explicit_ordering } {
        ::core::cmp::Ordering::Greater => assert_eq!(drops.get(), 3),
        ::core::cmp::Ordering::Less | ::core::cmp::Ordering::Equal => unreachable!(),
    }
    fn after(_: (), count: u8) { assert_eq!(count, 4); }
    after(
        {
            match Err(Observe(&drops)) {
                Ok(()) => { unreachable!() },
                ::core::result::Result::Err(_) => {},
            };
        },
        drops.get(),
    );
}

fn main() {
    assert_eq!(Command::Move(1, 2).destination(), 3);
    assert_eq!(Command::Close.destination(), 0);
    assert_eq!(Command::Draw { length: 5 }.destination(), 0);
    assert_eq!(Command::r#move.destination(), 0);
    assert_eq!(payload(Ok(Some(6))), 6);
    assert_eq!(payload(Ok(None)), 0);
    assert_eq!(payload(Err(())), 0);
    assert_eq!(pair(&Some(7), &Some(8)), 15);
    assert_eq!(pair(&None, &Some(8)), 0);
    assert_eq!(pair(&Some(8), &None), 0);
    assert_eq!(table(&Table(None), &Table(Some(4))), 4);
    assert_eq!(table(&Table(None), &Table(None)), 0);
    assert_eq!(marker(0), "empty");
    assert_eq!(marker(1), "text");
    assert_eq!(has_neighbors(&[]), "isolated");
    assert_eq!(has_neighbors(&[1]), "neighbors");
    ordered_arms();
    drop_scopes();
}
